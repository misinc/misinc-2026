# MIS, Inc. — Cloudflare Pages response headers
#
# Cloudflare handles HTTPS, HSTS, and compression at the edge. What it does not
# set for you is the small group of headers below, and the cache policy for
# fingerprinted assets.
#
# There is deliberately no Content-Security-Policy here yet. The site loads no
# third-party scripts except the Cal.com embed on /free-consultation, which
# injects its own frames and scripts at runtime — a CSP written without testing
# that page properly would silently break the only booking flow on the site.
# Worth adding, but as its own change with the booking flow verified after.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Astro fingerprints these filenames, so a year is safe and a changed file
# arrives under a new name rather than waiting for a cache to expire.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images and video keep their names across deploys, so they get a day in the
# browser and a week at the edge, revalidated rather than trusted blindly.
/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/video/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# These change with content, so they should never be served stale.
/sitemap-index.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600

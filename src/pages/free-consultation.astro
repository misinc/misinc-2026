---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PageHero from '../components/PageHero.astro';
import CalEmbed from '../components/CalEmbed.astro';
import FaqList from '../components/FaqList.astro';
import Testimonial from '../components/Testimonial.astro';
import { site, yearsInBusiness } from '../lib/site';

const work = await getCollection('work')
const quote = work.find((w) => w.id === 'kat-jacob-realtor')

const faqs = (await getCollection('faqs'))
  .filter((f) =>
    ['is-the-consultation-free', 'do-i-need-to-know-what-i-want', 'how-quickly-will-i-hear-back'].includes(
      f.id,
    ),
  )
  .sort((a, b) => a.data.order - b.data.order)

const expectations = [
  {
    title: 'You talk, we listen',
    body: 'Tell us what is happening in the business and what is frustrating you about your current site. No slides, no pitch deck.',
  },
  {
    title: 'We give you a straight read',
    body: 'What we would do, what we would not bother with, and roughly what it involves. Including when the answer is that you do not need us.',
  },
  {
    title: 'You decide in your own time',
    body: 'If it makes sense, we follow up with a written proposal and a fixed price. If it does not, you have still had a useful half hour.',
  },
]

const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Free web design and AI strategy consultation',
  description:
    'A free 30-minute consultation with MIS, Inc. in Albuquerque covering websites, e-commerce, SEO, custom software, and practical AI.',
  provider: { '@id': `${site.url}/#organization` },
  areaServed: [
    { '@type': 'City', name: 'Albuquerque' },
    { '@type': 'State', name: 'New Mexico' },
  ],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  url: `${site.url}/free-consultation`,
}
---

<Base
  title="Book a Free Consultation | MIS, Inc. Albuquerque"
  description="Book a free 30-minute consultation with MIS, Inc. in Albuquerque. Honest advice on your website, e-commerce, SEO, custom software, or AI, with no obligation."
  schema={eventSchema}
>
  <div class="border-b border-line">
    <PageHero eyebrow="Free consultation" title="Our expertise at no cost to you" lede={`Pick a time that suits you. We will look at what you have, tell you honestly what would improve it, and give you a clear idea of scope and cost, drawing on ${yearsInBusiness} years of doing this in Albuquerque.`} note="" media={{
        type: 'image',
        src: '/img/office-marquette.jpg',
        alt: 'The MIS, Inc. office building in downtown Albuquerque',
        caption: 'Downtown Albuquerque',}} showMedia={false} layout="background" overlayOpacity={95} />
  </div>

  <!-- What to expect -->
  <Section variant="tint" width="full">
    <div class="mx-auto max-w-(--container-content) px-6 py-12 md:px-10 lg:py-14">
      <h2 class="sr-only">What to expect</h2>
      <div class="grid gap-6 lg:grid-cols-3">
        {
          expectations.map((e, i) => (
            <div class="flex gap-4" data-reveal>
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-paper-panel font-display text-[15px] font-bold text-primary tabular-nums">
                {i + 1}
              </span>
              <div>
                <h3 class="mb-1 font-display text-base font-bold text-ink">{e.title}</h3>
                <p class="text-sm text-ink-soft">{e.body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- Booking -->
  <Section>
    <SectionHeader eyebrow="Pick a time" title="Book your consultation" lede="Thirty minutes, by video or preferably in person at our downtown office or yours if you're local." class="mb-8" />

    <CalEmbed calLink="misinc/free-consultation" namespace="free-consultation" />

    <p class="mt-6 text-sm text-ink-muted">
      Prefer not to book online? Call
      <a href={site.phoneHref} class="font-bold text-ink-soft no-underline hover:text-primary">
        {site.phone}
      </a>
      or <a href="/contact" class="font-bold text-primary no-underline hover:underline">send a message</a>.
    </p>
  </Section>

  {
    quote?.data.testimonial && (
      <Section variant="tint" width="full">
        <div class="mx-auto max-w-(--container-content) px-6 py-14 md:px-10 lg:py-16">
          <Testimonial
            quote={quote.data.testimonial.quote}
            attribution={quote.data.testimonial.attribution}
            href={`/works/${quote.id}`}
          />
        </div>
      </Section>
    )
  }

  <Section divider={false}>
    <SectionHeader eyebrow="Before you book" title="Common questions" class="mb-8" />
    <FaqList items={faqs} openFirst />
  </Section>
</Base>

---
import Base from '../layouts/Base.astro'
import Button from '../components/Button.astro'

/**
 * TEMPORARY — hero layout comparison. Delete before launch.
 * Not linked, noindexed, excluded from the sitemap in astro.config.mjs.
 *
 * The problem being solved, measured rather than assumed. At the hero size
 * (57.6px) in Fraunces, the two clauses set at:
 *
 *   "The web keeps changing."            677px
 *   "We've been building it since 1995." 906px   <- the binding constraint
 *
 * The current text column is about 520px (1.08fr of a 1080px container), so
 * neither clause fits and the headline breaks mid-phrase four times. Fraunces
 * gets blamed for what is really a measure problem — the same font on two
 * lines looks completely different.
 *
 * Widening the column alone does not fix it: even 2fr/1fr only reaches ~643px,
 * still short of 906. So each variation below reaches two clean lines a
 * different way — by giving the headline the full width, by reducing the type
 * until the long clause fits, or by re-breaking the sentence into phrases
 * short enough for the column it has.
 *
 * The poster still stands in for the video — it is the video's first frame, so
 * the composition is identical, and five autoplaying copies of a 4.8 MB file
 * would tell us nothing extra.
 */

const EYEBROW = 'Web design · Custom software · Practical AI'
const LEDE =
  'MIS, Inc. is a boutique web design and development studio based in Albuquerque, New Mexico. We build websites, custom software, and practical AI for small businesses and nonprofits — here at home and around the world.'
const NOTE = 'A real conversation with the people who’ll actually do the work.'
const POSTER = '/img/anniversary-balloon-poster.jpg'
const CAPTION = 'Our 30th anniversary balloon over Albuquerque'

const variations = [
  {
    n: 1,
    name: 'Headline spans the full width',
    change: 'H1 breaks out above the two-column row; lede, buttons and media sit beneath it.',
    why: 'The headline gets the whole 1080px — comfortably past the 906px the long clause needs — so it sets in two lines at full size with room to spare.',
  },
  {
    n: 2,
    name: 'Centred, landscape media below',
    change: 'Everything centred at a 900px measure, media full width underneath in 16:9.',
    why: 'Two lines at full size, just. Also suits the landscape source video, which is currently cropped hard to portrait.',
  },
  {
    n: 3,
    name: 'Wider column, slightly smaller type',
    change: 'Grid goes to 2fr / 1fr and type drops from 57.6px to 40px.',
    why: 'Keeps the side-by-side composition. 2fr/1fr gives 643px, and at 40px the long clause needs 660px — so it lands on two lines with the break falling naturally.',
  },
  {
    n: 4,
    name: 'Current layout, smaller type',
    change: 'Nothing moves except the type: 57.6px down to 32px.',
    why: 'The only way to get two lines without touching the layout, because the 520px column needs the long clause under 522px. Costs the most presence.',
  },
  {
    n: 5,
    name: 'Re-broken into three phrases',
    change: 'Full size in a 2fr / 1fr column, but the sentence breaks after “building it”.',
    why: 'Three lines that are each a phrase, rather than two that need 906px. Every line break lands where you would pause reading it aloud.',
  },
]
---

<Base
  title="Hero layout comparison (temporary)"
  description="Internal page for comparing hero layouts. Not part of the site."
  noindex
>
  <div class="mx-auto max-w-(--container-content) px-6 py-12 md:px-10">
    <span class="text-xs font-bold uppercase tracking-(--tracking-label) text-primary">
      Temporary &middot; not linked, not indexed
    </span>
    <h1 class="my-4 text-3xl font-bold text-ink" style="font-family: var(--font-sans)">
      Hero layout comparison
    </h1>
    <p class="max-w-(--container-prose) text-ink-soft">
      Same headline, same font, five ways of giving it room. Each block reports the width its
      headline actually gets and how many lines it lands on &mdash; measured live, so resize
      the window and watch them change.
    </p>
    <p class="mt-4 max-w-(--container-prose) text-sm text-ink-muted">
      The number to beat is <b class="text-ink-soft">906px</b>: that is what &ldquo;We&rsquo;ve
      been building it since 1995.&rdquo; needs at the current 57.6px. The home page gives it
      520px, which is why it breaks four times. Widening the column alone never gets there
      &mdash; even 2fr/1fr only reaches about 643px.
    </p>
  </div>

  {
    variations.map((v) => (
      <section class="border-t border-line" data-variation>
        <div class="mx-auto max-w-(--container-content) px-6 pt-10 md:px-10">
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <span class="font-sans text-xs font-extrabold uppercase tracking-(--tracking-label) text-ink-muted">
              {v.n}. {v.name}
            </span>
            <span
              class="font-sans text-[11px] font-extrabold uppercase tracking-(--tracking-label) text-primary"
              data-readout
            />
          </div>
          <p class="mt-2 max-w-(--container-prose) font-sans text-sm text-ink-soft">{v.change}</p>
          <p class="mt-1 max-w-(--container-prose) font-sans text-sm text-ink-muted">{v.why}</p>
        </div>

        {v.n === 1 && (
          <div class="mx-auto max-w-(--container-content) px-6 py-12 md:px-10">
            <span class="text-xs font-bold uppercase tracking-(--tracking-label) text-primary">
              {EYEBROW}
            </span>
            <h2 class="my-6 text-4xl font-bold text-ink" data-headline>
              The web keeps changing. We’ve been building it{' '}
              <span class="text-primary">since&nbsp;1995.</span>
            </h2>
            <div class="grid items-end gap-9 lg:grid-cols-[1fr_0.85fr]">
              <div>
                <p class="mb-7 max-w-(--container-prose) text-lg text-ink-soft">{LEDE}</p>
                <div class="flex flex-wrap items-center gap-3.5">
                  <Button href="#">Book a free strategy call</Button>
                  <Button href="#" variant="ghost">See our projects</Button>
                </div>
                <p class="mt-4 text-sm font-semibold text-ink-muted">{NOTE}</p>
              </div>
              <figure class="m-0 overflow-hidden rounded-md border border-line-soft shadow-media">
                <div class="relative aspect-[16/10]">
                  <img src={POSTER} alt="" class="absolute inset-0 h-full w-full object-cover" />
                  <figcaption class="absolute inset-x-0 bottom-0 bg-linear-to-t from-ink/75 to-transparent px-4 pb-3.5 pt-6 text-xs font-bold uppercase tracking-(--tracking-label) text-[#fff6e6]">
                    {CAPTION}
                  </figcaption>
                </div>
              </figure>
            </div>
          </div>
        )}

        {v.n === 2 && (
          <div class="mx-auto max-w-(--container-content) px-6 py-12 md:px-10">
            <div class="mx-auto max-w-[900px] text-center">
              <span class="text-xs font-bold uppercase tracking-(--tracking-label) text-primary">
                {EYEBROW}
              </span>
              <h2 class="my-6 text-4xl font-bold text-ink" data-headline>
                The web keeps changing.
                <br />
                We’ve been building it <span class="text-primary">since&nbsp;1995.</span>
              </h2>
              <p class="mx-auto mb-7 max-w-(--container-prose) text-lg text-ink-soft">{LEDE}</p>
              <div class="flex flex-wrap items-center justify-center gap-3.5">
                <Button href="#">Book a free strategy call</Button>
                <Button href="#" variant="ghost">See our projects</Button>
              </div>
              <p class="mt-4 text-sm font-semibold text-ink-muted">{NOTE}</p>
            </div>
            <figure class="m-0 mt-11 overflow-hidden rounded-md border border-line-soft shadow-media">
                <div class="relative aspect-[16/9]">
                  <img src={POSTER} alt="" class="absolute inset-0 h-full w-full object-cover" />
                  <figcaption class="absolute inset-x-0 bottom-0 bg-linear-to-t from-ink/75 to-transparent px-4 pb-3.5 pt-6 text-xs font-bold uppercase tracking-(--tracking-label) text-[#fff6e6]">
                    {CAPTION}
                  </figcaption>
                </div>
              </figure>
          </div>
        )}

        {v.n === 3 && (
          <div class="mx-auto max-w-(--container-content) px-6 md:px-10">
            <div class="grid items-center gap-9 py-12 lg:grid-cols-[2fr_1fr]">
              <div>
                <span class="text-xs font-bold uppercase tracking-(--tracking-label) text-primary">
                  {EYEBROW}
                </span>
                <h2 class="my-5 font-bold text-ink" style="font-size: clamp(1.9rem, 3vw, 2.5rem); line-height: 1.12" data-headline>
                  The web keeps changing.
                  <br />
                  We’ve been building it <span class="text-primary">since&nbsp;1995.</span>
                </h2>
                <p class="mb-7 max-w-(--container-prose) text-lg text-ink-soft">{LEDE}</p>
                <div class="flex flex-wrap items-center gap-3.5">
                  <Button href="#">Book a free strategy call</Button>
                  <Button href="#" variant="ghost">See our projects</Button>
                </div>
                <p class="mt-4 text-sm font-semibold text-ink-muted">{NOTE}</p>
              </div>
              <figure class="m-0 overflow-hidden rounded-md border border-line-soft shadow-media">
                <div class="relative aspect-[16/10] lg:aspect-[4/5]">
                  <img src={POSTER} alt="" class="absolute inset-0 h-full w-full object-cover" />
                  <figcaption class="absolute inset-x-0 bottom-0 bg-linear-to-t from-ink/75 to-transparent px-4 pb-3.5 pt-6 text-xs font-bold uppercase tracking-(--tracking-label) text-[#fff6e6]">
                    {CAPTION}
                  </figcaption>
                </div>
              </figure>
            </div>
          </div>
        )}

        {v.n === 4 && (
          <div class="mx-auto max-w-(--container-content) px-6 md:px-10">
            <div class="grid items-center gap-9 py-12 lg:grid-cols-[1.08fr_0.92fr]">
              <div>
                <span class="text-xs font-bold uppercase tracking-(--tracking-label) text-primary">
                  {EYEBROW}
                </span>
                <h2 class="my-5 font-bold text-ink" style="font-size: clamp(1.7rem, 2.4vw, 2rem); line-height: 1.15" data-headline>
                  The web keeps changing.
                  <br />
                  We’ve been building it <span class="text-primary">since&nbsp;1995.</span>
                </h2>
                <p class="mb-7 max-w-(--container-prose) text-lg text-ink-soft">{LEDE}</p>
                <div class="flex flex-wrap items-center gap-3.5">
                  <Button href="#">Book a free strategy call</Button>
                  <Button href="#" variant="ghost">See our projects</Button>
                </div>
                <p class="mt-4 text-sm font-semibold text-ink-muted">{NOTE}</p>
              </div>
              <figure class="m-0 overflow-hidden rounded-md border border-line-soft shadow-media">
                <div class="relative aspect-[16/10] lg:aspect-[4/5]">
                  <img src={POSTER} alt="" class="absolute inset-0 h-full w-full object-cover" />
                  <figcaption class="absolute inset-x-0 bottom-0 bg-linear-to-t from-ink/75 to-transparent px-4 pb-3.5 pt-6 text-xs font-bold uppercase tracking-(--tracking-label) text-[#fff6e6]">
                    {CAPTION}
                  </figcaption>
                </div>
              </figure>
            </div>
          </div>
        )}

        {v.n === 5 && (
          <div class="mx-auto max-w-(--container-content) px-6 md:px-10">
            <div class="grid items-center gap-9 py-12 lg:grid-cols-[2fr_1fr]">
              <div>
                <span class="text-xs font-bold uppercase tracking-(--tracking-label) text-primary">
                  {EYEBROW}
                </span>
                <h2 class="my-5 font-bold text-ink text-4xl" data-headline>
                  The web keeps changing.
                  <br />
                  We’ve been building it
                  <br />
                  <span class="text-primary">since&nbsp;1995.</span>
                </h2>
                <p class="mb-7 max-w-(--container-prose) text-lg text-ink-soft">{LEDE}</p>
                <div class="flex flex-wrap items-center gap-3.5">
                  <Button href="#">Book a free strategy call</Button>
                  <Button href="#" variant="ghost">See our projects</Button>
                </div>
                <p class="mt-4 text-sm font-semibold text-ink-muted">{NOTE}</p>
              </div>
              <figure class="m-0 overflow-hidden rounded-md border border-line-soft shadow-media">
                <div class="relative aspect-[16/10] lg:aspect-[4/5]">
                  <img src={POSTER} alt="" class="absolute inset-0 h-full w-full object-cover" />
                  <figcaption class="absolute inset-x-0 bottom-0 bg-linear-to-t from-ink/75 to-transparent px-4 pb-3.5 pt-6 text-xs font-bold uppercase tracking-(--tracking-label) text-[#fff6e6]">
                    {CAPTION}
                  </figcaption>
                </div>
              </figure>
            </div>
          </div>
        )}
      </section>
    ))
  }

  <div class="border-t border-line">
    <div class="mx-auto max-w-(--container-content) px-6 py-12 md:px-10">
      <p class="max-w-(--container-prose) text-sm text-ink-muted">
        3, 4 and 5 are changes to <code class="font-mono text-ink-soft">PageHero.astro</code> and
        would apply to every page&rsquo;s hero. 1 and 2 are different structures and would need a
        home-page-only variant of the component.
      </p>
    </div>
  </div>

  <script>
    // Measure what each headline actually gets, so the choice is made on
    // numbers rather than on how it happens to look at one window size.
    const measure = () => {
      document.querySelectorAll<HTMLElement>('[data-variation]').forEach((section) => {
        const h = section.querySelector<HTMLElement>('[data-headline]')
        const out = section.querySelector<HTMLElement>('[data-readout]')
        if (!h || !out) return
        const cs = getComputedStyle(h)
        const lineHeight = parseFloat(cs.lineHeight) || parseFloat(cs.fontSize) * 1.1
        const lines = Math.round(h.getBoundingClientRect().height / lineHeight)
        out.textContent = `${Math.round(h.getBoundingClientRect().width)}px wide · ${lines} lines · ${Math.round(parseFloat(cs.fontSize))}px type`
      })
    }
    measure()
    addEventListener('resize', measure)
    document.fonts?.ready.then(measure)
  </script>
</Base>

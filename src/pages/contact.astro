---
import Base from '../layouts/Base.astro'
import Section from '../components/Section.astro'
import SectionHeader from '../components/SectionHeader.astro'
import PageHero from '../components/PageHero.astro'
import ContactForm from '../components/ContactForm.astro'
import StaticMap from '../components/StaticMap.astro'
import Faq from '../components/Faq.astro'
import { site, mapsUrl, yearsInBusiness } from '../lib/site'

const faqs = [
  {
    q: 'How quickly will I hear back?',
    a: 'Within one business day, and usually the same day. Messages come to Karim directly — there is no intake team or ticket queue between you and the person who would do the work.',
  },
  {
    q: 'Do I need to know what I want before I get in touch?',
    a: 'No. Most useful first conversations start with a problem rather than a specification — the site looks dated, enquiries have dried up, something takes too long every week. Working out what to build is part of what we do.',
  },
  {
    q: 'Is the consultation really free?',
    a: 'Yes, and there is no obligation attached. You will get honest recommendations either way, including when the honest recommendation is that you do not need us.',
  },
  {
    q: 'Do you work with businesses outside New Mexico?',
    a: `Yes. We have worked with clients across the U.S. and internationally since 1995. Our focus is on Albuquerque and New Mexico, but ${yearsInBusiness} years in, distance has never been the obstacle people expect.`,
  },
]

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contact ${site.name}`,
  mainEntity: { '@id': `${site.url}/#organization` },
}
---

<Base
  title="Contact MIS, Inc. — Albuquerque Web Design & Development"
  description={`Get in touch with MIS, Inc. in downtown Albuquerque. ${site.address.street}, ${site.address.city}, ${site.address.region}. Call ${site.phone} or email ${site.email}.`}
  schema={contactSchema}
>
  <div class="border-b border-line">
    <PageHero
      eyebrow="Contact"
      title="Tell us what you’re trying to fix"
      lede="You do not need a specification or a budget worked out. Describe the problem and we will tell you honestly what would solve it — and whether we are the right studio for it."
      media={{
        type: 'image',
        src: '/img/office-marquette.jpg',
        alt: 'The office building at 500 Marquette Avenue NW in downtown Albuquerque',
        caption: 'Downtown Albuquerque',
      }}
    />
  </div>

  <Section>
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_320px]">
      <div>
        <SectionHeader
          eyebrow="Send a message"
          title="Start a conversation"
          lede="Every message goes straight to Karim. You will hear back within one business day."
          class="mb-8"
        />
        <ContactForm />
      </div>

      <aside class="flex flex-col gap-6">
        <div class="rounded-lg border border-line-soft bg-paper-panel p-6 shadow-card" data-reveal>
          <h2 class="mb-4 font-sans text-xs font-extrabold uppercase tracking-(--tracking-label) text-ink-muted">
            Get in touch
          </h2>

          <div class="flex flex-col gap-4 text-[15px]">
            <div>
              <span class="block text-xs font-extrabold uppercase tracking-(--tracking-label) text-ink-muted">
                Call
              </span>
              <a
                href={site.phoneHref}
                class="font-display text-lg font-bold text-ink no-underline hover:text-primary"
              >
                {site.phone}
              </a>
            </div>

            <div>
              <span class="block text-xs font-extrabold uppercase tracking-(--tracking-label) text-ink-muted">
                Email
              </span>
              <a
                href={`mailto:${site.email}`}
                class="font-bold text-ink-soft no-underline hover:text-primary"
              >
                {site.email}
              </a>
            </div>

            <div>
              <span class="block text-xs font-extrabold uppercase tracking-(--tracking-label) text-ink-muted">
                Visit
              </span>
              <address class="not-italic text-ink-soft">
                {site.address.street}<br />
                {site.address.city}, {site.address.region} {site.address.postalCode}
              </address>
            </div>

            <div>
              <span class="block text-xs font-extrabold uppercase tracking-(--tracking-label) text-ink-muted">
                Hours
              </span>
              <p class="text-ink-soft">
                Monday to Friday, 9am&ndash;5pm Mountain Time.<br />
                <span class="text-ink-muted">Visits by appointment.</span>
              </p>
            </div>
          </div>
        </div>

        <a
          href={mapsUrl}
          class="block overflow-hidden rounded-lg border border-line-soft shadow-card"
          aria-label="Open our location in Google Maps"
          data-reveal
        >
          <StaticMap height="220px" />
        </a>
      </aside>
    </div>
  </Section>

  <Section variant="tint" width="full">
    <div class="mx-auto max-w-(--container-content) px-6 py-14 md:px-10 lg:py-20">
      <SectionHeader
        eyebrow="Before you write"
        title="What happens after you send this"
        class="mb-10"
      />
      <Faq items={faqs} />
    </div>
  </Section>
</Base>

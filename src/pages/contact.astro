---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import StaticMap from '../components/StaticMap.astro';
import FaqList from '../components/FaqList.astro';
import { getCollection } from 'astro:content';
import { site, mapsUrl } from '../lib/site';

const faqs = (await getCollection('faqs'))
  .filter((f) => f.data.showOn.includes('contact'))
  .sort((a, b) => a.data.order - b.data.order)

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contact ${site.name}`,
  mainEntity: { '@id': `${site.url}/#organization` },
}
---

<Base
  title="Contact MIS, Inc. | Albuquerque Web Design & Development"
  description={`Get in touch with MIS, Inc. in downtown Albuquerque. ${site.address.street}, ${site.address.city}, ${site.address.region}. Call ${site.phone} or email ${site.email}.`}
  schema={contactSchema}
>
  <div class="border-b border-line">
    <PageHero eyebrow="Contact" title="Tell us what you need help with" lede="Describe the problem and we will tell you honestly what would solve it and whether we are the right studio for it." media={{
        type: 'image',
        src: '/img/office-marquette.jpg',
        alt: 'MIS, Inc. office building at 500 Marquette Avenue NW in downtown Albuquerque',
        caption: 'Downtown Albuquerque',
      }} layout="background" overlayOpacity={95} />
  </div>

  <Section>
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_320px]">
      <div>
        <div
          class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-line-soft bg-paper-tint px-5 py-4"
          data-reveal
        >
          <p class="text-[15px] font-semibold text-ink-soft">
            Already know you want to start a project? Skip this form and tell us the details directly.
          </p>
          <a
            href="/start-a-project"
            class="shrink-0 text-sm font-extrabold text-primary no-underline hover:underline"
          >
            Start a project &rarr;
          </a>
        </div>

        <SectionHeader eyebrow="Send us a message" title="Start a conversation" lede="You will hear back within one business day." class="mb-8" />
        <ContactForm />
      </div>

      <aside class="flex flex-col gap-6">
        <div class="rounded-lg border border-line-soft bg-paper-panel p-6 shadow-card" data-reveal>
          <h2 class="mb-4 font-sans text-xs font-extrabold uppercase tracking-(--tracking-label) text-ink-muted">
            Get in touch
          </h2>

          <div class="flex flex-col gap-4 text-[15px]">
            <div>
              <span class="block text-xs font-extrabold uppercase tracking-(--tracking-label) text-ink-muted">
                Call
              </span>
              <a
                href={site.phoneHref}
                class="font-display text-lg font-bold text-ink no-underline hover:text-primary"
              >
                {site.phone}
              </a>
            </div>

            <div>
              <span class="block text-xs font-extrabold uppercase tracking-(--tracking-label) text-ink-muted">
                Email
              </span>
              <a
                href={`mailto:${site.email}`}
                class="font-bold text-ink-soft no-underline hover:text-primary"
              >
                {site.email}
              </a>
            </div>

            <div>
              <span class="block text-xs font-extrabold uppercase tracking-(--tracking-label) text-ink-muted">
                Visit
              </span>
              <address class="not-italic text-ink-soft">
                {site.address.street}<br />
                {site.address.city}, {site.address.region} {site.address.postalCode}
              </address>
            </div>

            <div>
              <span class="block text-xs font-extrabold uppercase tracking-(--tracking-label) text-ink-muted">
                Hours
              </span>
              <p class="text-ink-soft">Monday to Friday, 9am&ndash;5pm<br />Mountain Time.<br /><span class="text-ink-muted">Visits by appointment only.</span></p>
            </div>
          </div>
        </div>

        <a
          href={mapsUrl}
          class="block overflow-hidden rounded-lg border border-line-soft shadow-card"
          aria-label="Open our location in Google Maps"
          data-reveal
        >
          <StaticMap height="220px" />
        </a>
      </aside>
    </div>
  </Section>

  <Section variant="tint" width="full">
    <div class="mx-auto max-w-(--container-content) px-6 py-14 md:px-10 lg:py-20">
      <SectionHeader
        eyebrow="Before you write"
        title="What happens after you send this"
        class="mb-10"
      />
      <FaqList items={faqs} openFirst />
    </div>
  </Section>
</Base>

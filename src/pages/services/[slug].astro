---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Prose from '../../components/Prose.astro';
import NextStep from '../../components/NextStep.astro';
import Card from '../../components/Card.astro';
import Button from '../../components/Button.astro';
import CtaBand from '../../components/CtaBand.astro';
import PlatformChips from '../../components/PlatformChips.astro';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  const services = await getCollection('services')
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service, all: services },
  }))
}

const { service, all } = Astro.props
const { Content } = await render(service)

const projects = await getCollection('work')
const broadPortfolioServices = new Set(['web-design', 'website-development'])
const portfolioCategoryByService = {
  'healthcare-website-design': 'healthcare',
  'real-estate-website-design': 'real-estate',
  'nonprofit-web-design': 'nonprofit',
  'ecommerce-website-design': 'ecommerce',
} as const
const portfolioCategory =
  portfolioCategoryByService[service.id as keyof typeof portfolioCategoryByService]
const usesPortfolioPool = broadPortfolioServices.has(service.id) || Boolean(portfolioCategory)
const heroChoices = usesPortfolioPool
  ? projects
      .filter(
        (project) =>
          !project.data.archived &&
          project.data.client !== 'MIS, Inc.' &&
          project.data.image.startsWith('/img/work/') &&
          (!portfolioCategory || project.data.category.includes(portfolioCategory)),
      )
      .sort((a, b) => a.data.title.localeCompare(b.data.title))
      .map((project) => ({
        src: project.data.image,
        alt: project.data.imageAlt,
        caption: project.data.title,
      }))
  : []

const PILLAR_LABEL = {
  websites: 'Websites',
  growth: 'Growth',
  'software-ai': 'Software & AI',
} as const

// Sibling services in the same pillar, so every page offers a next step.
const related = all
  .filter((s) => s.data.pillar === service.data.pillar && s.id !== service.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3)

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.data.title,
  description: service.data.summary,
  serviceType: service.data.title,
  provider: { '@id': `${site.url}/#organization` },
  areaServed: [
    { '@type': 'City', name: 'Albuquerque' },
    { '@type': 'State', name: 'New Mexico' },
  ],
  url: `${site.url}/services/${service.id}`,
}

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${site.url}/services` },
    {
      '@type': 'ListItem',
      position: 3,
      name: service.data.title,
      item: `${site.url}/services/${service.id}`,
    },
  ],
}
---

<Base
  title={service.data.seo.title}
  description={service.data.seo.description}
  schema={[serviceSchema, breadcrumbs]}
>
  <div class="border-b border-line">
    <PageHero eyebrow={PILLAR_LABEL[service.data.pillar]} title={service.data.heading} lede={service.data.summary} media={service.data.hero} mediaChoices={heroChoices} fallbackLabel={service.data.heroLabel ?? service.data.title} ctas={[
        { label: 'Book a free consultation', href: '/free-consultation' },
        { label: 'See our projects', href: '/portfolio', variant: 'ghost' },
      ]} showMedia={true} layout="split">
      <Breadcrumbs
        slot="before"
        class="mb-5"
        items={[{ label: 'Services', href: '/services' }, { label: service.data.title }]}
      />
    </PageHero>
  </div>

  <Section>
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_280px]">
      <div>
        <div data-reveal>
          <Prose>
            <Content />
          </Prose>
        </div>
        <NextStep text={service.data.nextStep} class="mt-12" />
      </div>

      <aside class="flex flex-col gap-8">
        <PlatformChips platforms={service.data.platforms} />

        <div
          class="rounded-lg border border-line-soft bg-paper-panel p-6 shadow-card"
          data-reveal
        >
          <h2 class="mb-2 font-display text-lg font-bold text-ink">Talk it through</h2>
          <p class="mb-4 text-sm text-ink-soft">
            A short call, honest recommendations, and a clear price before anything starts.
          </p>
          <Button href="/free-consultation" class="w-full text-center">Book a free consultation</Button>
        </div>
      </aside>
    </div>
  </Section>

  {
    service.data.examples.length > 0 && (
      <Section variant="tint" width="full">
        <div class="mx-auto max-w-(--container-content) px-6 py-14 md:px-10 lg:py-20">
          <SectionHeader
            eyebrow="Selected examples"
            title="Software we have built"
            lede="These applications began with specific work that existing products did not handle cleanly. Each one was shaped around the people, information, and decisions involved in that process."
            class="mb-10"
          />
          <div class="grid gap-5 md:grid-cols-2">
            {service.data.examples.map((example) => (
              <Card
                variant="plain"
                tag="Custom application"
                title={example.name}
                blurb={example.summary}
                bullets={example.capabilities}
                class="p-7"
              />
            ))}
          </div>
        </div>
      </Section>
    )
  }

  {
    related.length > 0 && (
      <Section variant="tint" width="full">
        <div class="mx-auto max-w-(--container-content) px-6 py-14 md:px-10 lg:py-20">
          <SectionHeader
            eyebrow="Related"
            title={`More ${PILLAR_LABEL[service.data.pillar]} services`}
            class="mb-10"
          />
          <div class="grid gap-5 lg:grid-cols-3">
            {related.map((s) => (
              <Card
                variant="service"
                tag={s.data.title}
                title={s.data.heading}
                blurb={s.data.summary}
                href={`/services/${s.id}`}
                cta="Learn more"
              />
            ))}
          </div>
        </div>
      </Section>
    )
  }

  <Section divider={false}>
    <CtaBand />
  </Section>
</Base>

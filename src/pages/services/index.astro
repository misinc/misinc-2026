---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import Section from '../../components/Section.astro'
import SectionHeader from '../../components/SectionHeader.astro'
import PageHero from '../../components/PageHero.astro'
import Card from '../../components/Card.astro'
import CtaBand from '../../components/CtaBand.astro'
import FaqList from '../../components/FaqList.astro'
import { yearsInBusiness } from '../../lib/site'

const all = await getCollection('services')

const faqs = (await getCollection('faqs'))
  .filter((f) => f.data.showOn.includes('services'))
  .sort((a, b) => a.data.order - b.data.order)

const PILLARS = [
  {
    id: 'websites',
    eyebrow: 'Websites',
    title: 'Websites that work',
    short: 'Design, build, and care for the site your customers actually meet you on.',
    lede: 'The core of what we do, and what we have been doing since 1995. Sites built to bring you customers and to stay maintainable after launch.',
  },
  {
    id: 'growth',
    eyebrow: 'Growth',
    title: 'Getting found and staying found',
    short: 'Search, email, and advertising that turn a website into a source of business.',
    lede: 'Search, email, and advertising — the work that turns a website from a brochure into something that brings in business.',
  },
  {
    id: 'software-ai',
    eyebrow: 'Software & AI',
    title: 'Beyond the website',
    short: 'Custom tools, integrations, and practical AI for when off-the-shelf stops fitting.',
    lede: 'When the off-the-shelf tools stop fitting, we build what does — including the practical AI work that is now part of every technology decision.',
  },
] as const

const byPillar = PILLARS.map((p) => ({
  ...p,
  items: all
    .filter((s) => s.data.pillar === p.id)
    .sort((a, b) => a.data.order - b.data.order),
}))

---

<Base
  title="Web Design, SEO, Custom Software & AI Services | MIS, Inc."
  description="Services from MIS, Inc. in Albuquerque, New Mexico: website design and development, e-commerce, SEO and digital marketing, custom software, and practical AI — under one roof since 1995."
>
  <PageHero
    eyebrow="Services"
    title="Everything under one roof"
    lede={`From your first website to your first AI agent — so you are never coordinating three vendors who do not talk to each other. ${yearsInBusiness} years of doing this in Albuquerque.`}
    media={{
      type: 'video',
      src: '/video/anniversary-balloon-short.mp4',
      caption: 'Albuquerque, since 1995',
    }}
    ctas={[
      { label: 'Book a free consultation', href: '/free-consultation' },
      { label: 'See our work', href: '/portfolio', variant: 'ghost' },
    ]}
  />

  {/* Three pillars up front, so nobody leaves thinking we only build websites. */}
  <Section variant="tint" width="full">
    <div class="mx-auto max-w-(--container-content) px-6 py-12 md:px-10 lg:py-14">
      <h2 class="sr-only">What we do</h2>
      <div class="grid gap-5 lg:grid-cols-3">
        {
          byPillar.map((p, i) => (
            <a
              href={`#${p.id}`}
              class="group flex flex-col gap-2.5 rounded-lg border border-line-soft bg-paper-panel p-6 no-underline shadow-card transition hover:-translate-y-[3px] hover:shadow-card-hover"
              data-reveal
            >
              <span class="font-display text-2xl font-bold text-primary tabular-nums">
                0{i + 1}
              </span>
              <h3 class="font-display text-xl font-bold text-ink">{p.eyebrow}</h3>
              <p class="text-[15.5px] text-ink-soft">{p.short}</p>
              <span class="mt-2 text-sm font-extrabold text-ink-muted">
                {p.items.map((s) => s.data.title).join(' · ')}
              </span>
              <span class="mt-auto inline-flex items-center gap-2 pt-3 text-[15px] font-extrabold text-primary">
                Jump to {p.eyebrow.toLowerCase()}
                <span class="transition-transform group-hover:translate-y-0.5" aria-hidden="true">
                  &darr;
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </Section>

  {
    byPillar.map((pillar, i) => (
      <Section id={pillar.id} class="scroll-mt-24" variant={i % 2 === 1 ? 'tint' : 'default'} width="full">
        <div class="mx-auto max-w-(--container-content) px-6 py-14 md:px-10 lg:py-20">
          <SectionHeader
            eyebrow={pillar.eyebrow}
            title={pillar.title}
            lede={pillar.lede}
            class="mb-10"
          />

          <div class="grid gap-5 lg:grid-cols-3">
            {pillar.items.map((s) => (
              <Card
                variant="service"
                tag={s.data.title}
                title={s.data.heading}
                blurb={s.data.summary}
                bullets={s.data.highlights}
                href={`/services/${s.id}`}
                cta="Learn more"
              />
            ))}
          </div>
        </div>
      </Section>
    ))
  }

  <Section>
    <SectionHeader
      eyebrow="Common questions"
      title="Before you get in touch"
      class="mb-10"
    />
    <FaqList items={faqs} openFirst />
  </Section>

  <Section divider={false}>
    <CtaBand
      title="Not sure which of these you need?"
      note="That is what the call is for. Tell us the problem and we will tell you what would fix it."
    />
  </Section>
</Base>

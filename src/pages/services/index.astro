---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import Section from '../../components/Section.astro'
import SectionHeader from '../../components/SectionHeader.astro'
import Card from '../../components/Card.astro'
import CtaBand from '../../components/CtaBand.astro'
import Faq from '../../components/Faq.astro'
import { yearsInBusiness } from '../../lib/site'

const all = await getCollection('services')

const PILLARS = [
  {
    id: 'websites',
    eyebrow: 'Websites',
    title: 'Websites that work',
    lede: 'The core of what we do, and what we have been doing since 1995. Sites built to bring you customers and to stay maintainable after launch.',
  },
  {
    id: 'growth',
    eyebrow: 'Growth',
    title: 'Getting found and staying found',
    lede: 'Search, email, and advertising — the work that turns a website from a brochure into something that brings in business.',
  },
  {
    id: 'software-ai',
    eyebrow: 'Software & AI',
    title: 'Beyond the website',
    lede: 'When the off-the-shelf tools stop fitting, we build what does — including the practical AI work that is now part of every technology decision.',
  },
] as const

const byPillar = PILLARS.map((p) => ({
  ...p,
  items: all
    .filter((s) => s.data.pillar === p.id)
    .sort((a, b) => a.data.order - b.data.order),
}))

const faqs = [
  {
    q: 'Do I have to pick one service?',
    a: 'No. Most projects start with a website and grow from there — search work once the site is live, then automation once the business outgrows a manual process. You are not committing to a package.',
  },
  {
    q: 'What does a project typically cost?',
    a: 'Most small business websites land between $5,000 and $20,000 depending on page count, custom functionality, and whether you need ecommerce or integrations. Care plans and marketing are monthly. Every proposal states the number before work begins.',
  },
  {
    q: 'How long does a website take?',
    a: 'A straightforward small business site is usually six to ten weeks from kickoff to launch. The variable is almost never our build time — it is how quickly content, photography, and feedback come back.',
  },
  {
    q: 'Do you work with nonprofits?',
    a: 'Yes, and a good portion of our work is with New Mexico nonprofits. Tell us about your budget when you get in touch; we would rather scope a project to fit it than quote something out of reach.',
  },
]
---

<Base
  title="Web Design, SEO, Custom Software & AI Services | MIS, Inc."
  description="Services from MIS, Inc. in Albuquerque, New Mexico: website design and development, e-commerce, SEO and digital marketing, custom software, and practical AI — under one roof since 1995."
>
  <Section>
    <SectionHeader
      as="h1"
      eyebrow="Services"
      title="Everything under one roof"
      lede={`From your first website to your first AI agent — so you are never coordinating three vendors who do not talk to each other. ${yearsInBusiness} years of doing this in Albuquerque.`}
    />
  </Section>

  {
    byPillar.map((pillar, i) => (
      <Section id={pillar.id} variant={i % 2 === 1 ? 'tint' : 'default'} width="full">
        <div class="mx-auto max-w-(--container-content) px-6 py-14 md:px-10 lg:py-20">
          <SectionHeader
            eyebrow={pillar.eyebrow}
            title={pillar.title}
            lede={pillar.lede}
            class="mb-10"
          />

          <div class="grid gap-5 lg:grid-cols-3">
            {pillar.items.map((s) => (
              <Card
                variant="service"
                tag={s.data.title}
                title={s.data.heading}
                blurb={s.data.summary}
                bullets={s.data.highlights}
                href={`/services/${s.id}`}
                cta="Learn more"
              />
            ))}
          </div>
        </div>
      </Section>
    ))
  }

  <Section>
    <SectionHeader
      eyebrow="Common questions"
      title="Before you get in touch"
      class="mb-10"
    />
    <Faq items={faqs} />
  </Section>

  <Section divider={false}>
    <CtaBand
      title="Not sure which of these you need?"
      note="That is what the call is for. Tell us the problem and we will tell you what would fix it."
    />
  </Section>
</Base>

---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import PageHero from '../../components/PageHero.astro';
import Card from '../../components/Card.astro';
import CtaBand from '../../components/CtaBand.astro';
import FaqList from '../../components/FaqList.astro';

const all = await getCollection('services')

const faqs = (await getCollection('faqs'))
  .filter((f) => f.data.showOn.includes('services'))
  .sort((a, b) => a.data.order - b.data.order)

const PILLARS = [
  {
    id: 'websites',
    eyebrow: 'Websites',
    title: 'Websites that work',
    short: 'Plan, design, build, and maintain a website around the people who use it.',
    lede: 'The core of what we have done since 1995: clear, maintainable websites shaped around the organization, its audience, and the work the site needs to support.',
  },
  {
    id: 'growth',
    eyebrow: 'Growth',
    title: 'Getting found and staying found',
    short: 'SEO, AI-search readiness, and email marketing tied to useful business goals.',
    lede: 'Search and email work that improves qualified visibility, strengthens direct audience relationships, and reports what the available evidence supports.',
  },
  {
    id: 'software-ai',
    eyebrow: 'Software & AI',
    title: 'Beyond your website',
    short: 'Consulting, custom tools, integrations, and AI agents for defined operational problems.',
    lede: 'We assess the process first, then recommend consulting, standard automation, custom software, or a carefully limited AI agent when the work justifies it.',
  },
] as const

const byPillar = PILLARS.map((p) => ({
  ...p,
  items: all
    .filter((s) => s.data.pillar === p.id)
    .sort((a, b) => a.data.order - b.data.order),
}))
---

<Base
  title="Web Design, SEO, Custom Software & AI Services | MIS, Inc."
  description="Services from MIS, Inc. in Albuquerque, New Mexico: website design and development, e-commerce, SEO and digital marketing, custom software, and practical AI, under one roof since 1995."
>
  <PageHero eyebrow="Services" title="Websites, search, software and AI" lede={`One team can design and build the website, improve how people find it, and develop the tools that connect it to the rest of your work.`} media={{
      type: 'video',
      src: '/video/anniversary-balloon-short.mp4',
      caption: 'Albuquerque, since 1995',
    }} ctas={[
      { label: 'Book a free consultation', href: '/free-consultation' },
      { label: 'See our projects', href: '/portfolio', variant: 'ghost' },
    ]} layout="centered" showMedia={false} />

  {/* Three pillars up front, so nobody leaves thinking we only build websites. */}
  <Section variant="tint" width="full">
    <div class="mx-auto max-w-(--container-content) px-6 py-12 md:px-10 lg:py-14">
      <h2 class="sr-only">What we do</h2>
      <div class="grid gap-5 lg:grid-cols-3">
        {
          byPillar.map((p, i) => (
            <a
              href={`#${p.id}`}
              class="group flex flex-col gap-2.5 rounded-lg border border-line-soft bg-paper-panel p-6 no-underline shadow-card transition hover:-translate-y-[3px] hover:shadow-card-hover"
              data-reveal
            >
              <span class="font-display text-2xl font-bold text-primary tabular-nums">
                0{i + 1}
              </span>
              <h3 class="font-display text-xl font-bold text-ink">{p.eyebrow}</h3>
              <p class="text-[15.5px] text-ink-soft">{p.short}</p>
              <span class="mt-2 text-sm font-extrabold text-ink-muted">
                {p.items.map((s) => s.data.title).join(' · ')}
              </span>
              <span class="mt-auto inline-flex items-center gap-2 pt-3 text-[15px] font-extrabold text-primary">
                Jump to {p.eyebrow.toLowerCase()}
                <span class="transition-transform group-hover:translate-y-0.5" aria-hidden="true">
                  &darr;
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </Section>

  {
    byPillar.map((pillar, i) => (
      <Section id={pillar.id} class="scroll-mt-24" variant={i % 2 === 1 ? 'tint' : 'default'} width="full">
        <div class="mx-auto max-w-(--container-content) px-6 py-14 md:px-10 lg:py-20">
          <SectionHeader
            eyebrow={pillar.eyebrow}
            title={pillar.title}
            lede={pillar.lede}
            class="mb-10"
          />

          <div class="grid gap-5 lg:grid-cols-3">
            {pillar.items.map((s) => (
              <Card
                variant="service"
                tag={s.data.title}
                title={s.data.heading}
                blurb={s.data.summary}
                bullets={s.data.highlights}
                href={`/services/${s.id}`}
                cta="Learn more"
              />
            ))}
          </div>
        </div>
      </Section>
    ))
  }

  <Section>
    <SectionHeader
      eyebrow="Common questions"
      title="Before you get in touch"
      class="mb-10"
    />
    <FaqList items={faqs} openFirst />
  </Section>

  <Section divider={false}>
    <CtaBand
      title="Not sure which of these you need?"
      note="Tell us what is not working or what you need to accomplish. We will help identify the service, tool, or smaller change that fits."
    />
  </Section>
</Base>

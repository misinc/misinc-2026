---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PageHero from '../components/PageHero.astro';
import Card from '../components/Card.astro';
import CtaBand from '../components/CtaBand.astro';
import { yearsInBusiness } from '../lib/site';
import { breadcrumbs, collectionPage } from '../lib/schema';

/**
 * The hub URL and individual `/migrate/[slug]` routes predate this rebuild and
 * carry search history. See docs/seo-migration-map.md before renaming them.
 */
const migrations = (await getCollection('migrations')).sort(
  (a, b) => a.data.order - b.data.order,
)

const steps = [
  {
    title: 'Audit the site and the reason for moving',
    note: 'We review the content, functionality, traffic, platform account, and maintenance needs before deciding whether a migration is justified.',
  },
  {
    title: 'Inventory and map what exists',
    note: 'Important pages, media, metadata, forms, integrations, and URLs are recorded. Each item is marked to stay, improve, consolidate, redirect, or retire.',
  },
  {
    title: 'Rebuild and test before launch',
    note: 'The new site is tested for content, responsive behavior, accessibility, forms, analytics, integrations, redirects, indexing controls, and performance.',
  },
  {
    title: 'Launch, monitor, and keep redirects working',
    note: 'We check crawl errors, Search Console, analytics, forms, and important redirects after launch. Permanent redirects remain in place for at least a year and preferably longer.',
  },
]

const schema = [
  collectionPage({
    name: 'Website migrations',
    description: 'Moving a website from one platform to another while protecting content, established URLs, and existing search visibility.',
    path: '/website-migrations',
    items: migrations.map((m) => ({ name: m.data.title, href: `/migrate/${m.id}` })),
  }),
  breadcrumbs([{ name: 'Website migrations' }]),
]
---

<Base
  title="Website Migration Services | Careful Platform Moves | MIS, Inc."
  description="Website migration services for WordPress, Wix, Weebly, Shopify, Square, and Webflow, with content inventory, URL mapping, redirects, testing, and search monitoring."
  schema={schema}
>
  <div class="border-b border-line">
    <PageHero eyebrow="Website migrations" title="Move your website without discarding what already works" lede={`Over ${yearsInBusiness} years, we have moved websites between platforms that changed, closed, or no longer fit. A careful migration protects useful content, established URLs, working integrations, and the search visibility the site has already earned.`} ctas={[{ label: 'Book a free consultation', href: '/free-consultation' }]} layout="full" showMedia={false} />
  </div>

  <Section>
    <SectionHeader
      eyebrow="Common moves"
      title="Start with the platform you are leaving"
      lede="Each guide explains why a move may be worthwhile, what does and does not transfer, the typical timeline, and the situations where staying is the better decision."
      class="mb-10"
    />

    <div class="grid gap-5 md:grid-cols-2">
      {
        migrations.map((m) => (
          <Card
            variant="service"
            tag={`${m.data.from} → ${m.data.to}`}
            title={m.data.title}
            blurb={m.data.summary}
            href={`/migrate/${m.id}`}
            cta="How it works"
          />
        ))
      }
    </div>

    <p class="mt-8 max-w-(--container-prose) text-ink-soft">
      Moving from something else, such as Squarespace, GoDaddy, Duda, Adobe Business
      Catalyst, or a custom system? <a
        href="/start-a-project"
        class="font-bold text-primary no-underline hover:underline">Tell us what the site uses</a
      > and we will assess what a move would involve.
    </p>
  </Section>

  <Section variant="tint" width="full">
    <div class="mx-auto max-w-(--container-content) px-6 py-14 md:px-10 lg:py-20">
      <SectionHeader
        eyebrow="How it works"
        title="Four stages, with decisions inside each one"
        lede="A migration is not a file transfer. It is an inventory, a rebuild, a coordinated launch, and a period of verification."
        class="mb-10"
      />
      <div class="mx-auto flex max-w-(--container-prose) flex-col">
        {
          steps.map((s, i) => (
            <div
              class="flex items-start gap-4 py-5 not-first:border-t not-first:border-line-soft"
              data-reveal
            >
              <span class="grid h-[38px] w-[38px] shrink-0 place-items-center rounded-full bg-paper-panel font-display text-base font-bold text-primary">
                {i + 1}
              </span>
              <div>
                <b class="mb-1 block text-[16.5px] font-extrabold text-ink">{s.title}</b>
                <p class="text-sm text-ink-soft">{s.note}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <Section>
    <SectionHeader
      eyebrow="Search continuity"
      title="Reducing avoidable migration risk"
      class="mb-6"
    />
    <div class="max-w-(--container-prose) text-lg leading-relaxed text-ink-soft">
      <p class="mb-5">
        Search visibility can fluctuate while search engines recrawl and reindex a changed
        site. No agency can promise that rankings will remain unchanged. What we can do is
        avoid the preventable mistakes that make a move harder than it needs to be.
      </p>
      <p class="mb-5">
        We build the URL inventory from the existing crawl, sitemaps, analytics, Search
        Console, and other available records. Equivalent pages keep their addresses where
        practical or receive permanent redirects to the closest relevant destination.
        Deliberately consolidated pages are mapped to the new combined resource. Content
        with no replacement is allowed to retire instead of being redirected somewhere
        unrelated.
      </p>
      <p class="mb-5">
        Metadata and structured data are reviewed rather than copied without question.
        Internal links, canonical URLs, sitemaps, robots directives, and temporary
        development blocks are checked before launch. We then monitor indexing, traffic,
        errors, forms, and important actions as the new site is discovered.
      </p>
      <p>
        We used the same inventory and mapping process when <a
          href="/blog/rebuilding-our-own-website-2026"
          class="font-bold text-primary no-underline hover:underline">rebuilding this website</a
        >, preserving established addresses where they still served a purpose and using
        redirects only for deliberate consolidations.
      </p>
    </div>
  </Section>

  <Section divider={false}>
    <CtaBand
      title="Has your current platform become a constraint?"
      note="Tell us what is no longer working. We will assess whether migration is justified and what needs to be protected if you move."
    />
  </Section>
</Base>

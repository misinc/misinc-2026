---
import { getCollection, render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import Section from '../../components/Section.astro'
import SectionHeader from '../../components/SectionHeader.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import Prose from '../../components/Prose.astro'
import PostCard from '../../components/PostCard.astro'
import NextStep from '../../components/NextStep.astro'
import CtaBand from '../../components/CtaBand.astro'
import { site } from '../../lib/site'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, all: posts },
  }))
}

const { post, all } = Astro.props
const { Content } = await render(post)
const d = post.data

const newestFirst = (a: typeof post, b: typeof post) =>
  (b.data.updated ?? b.data.date).valueOf() -
  (a.data.updated ?? a.data.date).valueOf()

// Prefer substantial guides, then fill any remaining cards with other posts.
const related = [
  ...all.filter((p) => p.id !== post.id && p.data.guide).sort(newestFirst),
  ...all.filter((p) => p.id !== post.id && !p.data.guide).sort(newestFirst),
].slice(0, 3)

const published = d.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
})

const updated = d.updated?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
})

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.summary || undefined,
  datePublished: d.date.toISOString(),
  ...(d.updated && { dateModified: d.updated.toISOString() }),
  author: { '@id': `${site.url}/#organization` },
  publisher: { '@id': `${site.url}/#organization` },
  mainEntityOfPage: `${site.url}/blog/${post.id}`,
  ...(d.image && { image: new URL(d.image, site.url).href }),
}

const faqSchema =
  d.faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: d.faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site.url}/blog` },
    { '@type': 'ListItem', position: 3, name: d.title, item: `${site.url}/blog/${post.id}` },
  ],
}
---

<Base
  title={d.seo?.title ?? `${d.title} | MIS, Inc.`}
  description={d.seo?.description ?? d.summary}
  schema={[articleSchema, breadcrumbs, ...(faqSchema ? [faqSchema] : [])]}
>
  <Section>
    <Breadcrumbs
      class="mb-6"
      items={[{ label: 'Blog', href: '/blog' }, { label: d.title }]}
    />

    <div class="mb-4 flex flex-wrap items-center gap-3" data-reveal>
      <time
        datetime={d.date.toISOString().slice(0, 10)}
        class="text-xs font-extrabold uppercase tracking-(--tracking-label) text-ink-muted"
      >
        Published {published}
      </time>
      {
        d.updated && (
          <time
            datetime={d.updated.toISOString().slice(0, 10)}
            class="text-xs font-extrabold uppercase tracking-(--tracking-label) text-ink-muted"
          >
            Updated {updated}
          </time>
        )
      }
      {
        d.guide && (
          <span class="rounded-full bg-paper-surface px-2.5 py-1 text-[11px] font-extrabold uppercase tracking-(--tracking-label) text-primary">
            Guide
          </span>
        )
      }
    </div>

    <h1 class="max-w-[20ch] text-4xl font-bold text-ink" data-reveal>{d.title}</h1>

    {
      d.summary && (
        <p class="mt-5 max-w-(--container-prose) text-lg text-ink-soft" data-reveal>
          {d.summary}
        </p>
      )
    }
  </Section>

  <Section>
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_260px]">
      <div>
        <div data-reveal>
          <Prose>
            <Content />
          </Prose>
        </div>

        {
          d.faqs.length > 0 && (
            <div class="mt-12">
              <h2 class="mb-6 font-display text-2xl font-bold text-ink">
                Common questions
              </h2>
              <div class="max-w-[68ch]">
                {d.faqs.map((f, i) => (
                  <details class="group border-b border-line-soft py-1" open={i === 0} data-reveal>
                    <summary class="relative cursor-pointer list-none py-4 pr-10 font-display text-[19px] font-semibold text-ink hover:text-primary">
                      {f.q}
                      <span class="pointer-events-none absolute right-2 top-1/2 -mt-[7px] h-[11px] w-[11px] rotate-45 border-b-[2.5px] border-r-[2.5px] border-primary transition-transform group-open:-mt-[3px] group-open:rotate-[-135deg]" />
                    </summary>
                    <p class="m-0 pb-5 text-[15.5px] text-ink-soft">{f.a}</p>
                  </details>
                ))}
              </div>
            </div>
          )
        }

        <NextStep
          class="mt-12"
          title="Want a second opinion?"
          text="We have been building websites in Albuquerque since 1995. Book a free consultation and we will tell you honestly what would help, including when the answer is that you do not need us."
        />
      </div>

      <aside class="flex flex-col gap-6">
        <div
          class="rounded-lg border border-line-soft bg-paper-panel p-6 shadow-card"
          data-reveal
        >
          <h2 class="mb-2 font-display text-lg font-bold text-ink">Written by MIS, Inc.</h2>
          <p class="text-sm text-ink-soft">
            A boutique web design and development studio in Albuquerque, New Mexico. We have
            been building for the web since 1995.
          </p>
          <p class="mt-4 flex flex-col gap-1.5 text-sm">
            <a href="/about" class="font-bold text-primary no-underline hover:underline">
              About the studio &rarr;
            </a>
            <a href="/portfolio" class="font-bold text-primary no-underline hover:underline">
              See our projects &rarr;
            </a>
            <a href="/guides" class="font-bold text-primary no-underline hover:underline">
              More guides &rarr;
            </a>
          </p>
        </div>
      </aside>
    </div>
  </Section>

  {
    related.length > 0 && (
      <Section variant="tint" width="full">
        <div class="mx-auto max-w-(--container-content) px-6 py-14 md:px-10 lg:py-20">
          <SectionHeader eyebrow="Keep reading" title="More from the blog" class="mb-10" />
          <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {related.map((p) => (
              <PostCard
                slug={p.id}
                title={p.data.title}
                summary={p.data.summary}
                date={p.data.updated ?? p.data.date}
                updated={Boolean(p.data.updated)}
                guide={p.data.guide}
              />
            ))}
          </div>
        </div>
      </Section>
    )
  }

  <Section divider={false}>
    <CtaBand />
  </Section>
</Base>

---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageHero from '../components/PageHero.astro';
import Prose from '../components/Prose.astro';
import { site } from '../lib/site';

/**
 * Written to describe what this site actually does, not what a generator
 * assumes it does. Before changing anything here, check it against the code:
 * Fathom Analytics is loaded in Base.astro, the map is self-hosted tiles
 * (StaticMap.astro), fonts are self-hosted, Cal.com is embedded on
 * /free-consultation, and the 1995-mode preference is stored in localStorage.
 *
 * If any of that changes, this page has to change with it.
 */

const updated = '2026-08-23'
const updatedLabel = 'August 23, 2026'

// What we tell people up front. Every line has to stay true of the built site.
const summary = [
  'We use Fathom Analytics for cookie-free, aggregate traffic and conversion measurement. We do not use advertising pixels, behavioral profiles, or cross-site tracking.',
  'We receive information you send through a form, booking, email, or phone call. Cloudflare also processes standard technical information needed to serve and protect the site.',
  'Cal.com is used on the free consultation page, and Resend delivers website form submissions to our inbox.',
  'We do not sell or rent personal information. We use service providers only to operate the site and respond to you.',
  'You can ask what information we hold about you, request a correction, or ask us to delete it, subject to records we are required to keep.',
]

const processors = [
  {
    name: 'Fathom Analytics',
    role: 'Measures aggregate page traffic and successful form and consultation conversions without analytics cookies.',
    href: 'https://usefathom.com/legal/privacy',
  },
  {
    name: 'Resend',
    role: 'Delivers contact and project form messages to our inbox.',
    href: 'https://resend.com/legal/privacy-policy',
  },
  {
    name: 'Cal.com',
    role: 'Provides the booking calendar on the free consultation page.',
    href: 'https://cal.com/privacy',
  },
  {
    name: 'Cloudflare',
    role: 'Hosts, serves, and helps protect this website.',
    href: 'https://www.cloudflare.com/privacypolicy/',
  },
]

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Privacy policy',
      item: `${site.url}/privacy-policy`,
    },
  ],
}

// WebPage, not PrivacyPolicy — schema.org has no PrivacyPolicy type, and an
// invented one is silently ignored rather than helpfully interpreted.
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Privacy policy',
  url: `${site.url}/privacy-policy`,
  dateModified: updated,
  publisher: { '@id': `${site.url}/#organization` },
}
---

<Base
  title="Privacy Policy | MIS, Inc."
  description="What misinc.com collects, why it is collected, which services help operate the site, and the choices available to visitors. Written in plain English."
  schema={[breadcrumbs, pageSchema]}
>
  <!-- A legal page opens with the document rather than a marketing panel, so
       the hero runs with no media at all. -->
  <div class="border-b border-line">
    <PageHero layout="centered" eyebrow="Legal" title="Privacy policy" lede="We use limited, privacy-focused analytics, but we do not build advertising profiles or track people across websites. This page explains what information is handled when you browse, contact us, or book a consultation." showMedia={false}>
      <Breadcrumbs
        slot="before"
        items={[{ label: 'Home', href: '/' }, { label: 'Privacy policy' }]}
        class="mb-5"
      />
      <p slot="after" class="mt-4 text-sm text-ink-muted">
        Last updated {updatedLabel} · Applies to <strong class="font-extrabold text-ink-soft"
          >www.misinc.com</strong
        >
      </p>
    </PageHero>
  </div>

  <!-- The short version -->
  <Section variant="tint" width="full">
    <div class="mx-auto max-w-(--container-content) px-6 py-14 md:px-10 lg:py-16">
      <SectionHeader
        eyebrow="The short version"
        title="If you read nothing else"
        class="mb-8"
      />
      <ul class="flex max-w-[68ch] list-none flex-col gap-3 p-0" data-reveal>
        {
          summary.map((s) => (
            <li class="relative pl-7 text-[16.5px] text-ink-soft">
              <span class="absolute left-0 top-[3px] font-bold text-accent">&check;</span>
              {s}
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <!-- The policy itself -->
  <Section>
    <Prose>
      <h2>Who we are</h2>
      <p>
        This site is run by {site.legalName}, trading as MIS, Inc., a web design and
        development company in Albuquerque, New Mexico, in business since {site.founded}. You
        can reach us at <a href={`mailto:${site.email}`}>{site.email}</a> or
        <a href={site.phoneHref}>{site.phone}</a>.
      </p>
      <p>
        This policy covers <strong>www.misinc.com</strong> and nothing else. Websites we
        build and host for our clients are the client&rsquo;s own, with their own policies,
        and our AI consulting site at <a href={site.aiUrl}>misinc.ai</a> is separate.
      </p>

      <h2>What we collect, and when</h2>

      <h3>When you browse the site</h3>
      <p>
        Fathom Analytics measures aggregate page traffic, referral sources, campaigns, and a
        small number of successful conversions. We record fixed event names when a contact form
        or project form is successfully delivered and when a consultation is successfully booked.
        We do not send Fathom names, email addresses, booking IDs, form contents, website fields,
        or other visitor-provided values. Fathom does not set analytics cookies, build behavioral
        profiles, or track visitors across websites.
      </p>

      <h3>When you fill in the contact form</h3>
      <p>
        We receive the details you submit, which may include your name, email address, phone
        number, organization, current website, the subject or service you select, budget,
        timeline, and your message. Resend delivers the submission to our inbox. This website
        does not store a separate copy in a database.
      </p>

      <h3>When you book a free consultation</h3>
      <p>
        Booking runs on Cal.com, embedded on the
        <a href="/free-consultation">free consultation</a> page. When you book, Cal.com collects
        the information requested by the booking form, such as your name, email address, time
        zone, and any notes you provide. Cal.com then places the appointment on our calendar
        and sends the booking details. Its script loads only on that page.
      </p>

      <h3>When you email or call us</h3>
      <p>
        We keep the correspondence, the way any business keeps its email and its notes from
        a phone call.
      </p>

      <h3>Automatically, in the server log</h3>
      <p>
        Cloudflare processes standard request information when it serves the site, such as an
        IP address, browser and device details, the requested page, and the time of the request.
        Cloudflare uses this information to deliver content, maintain security, block abuse,
        and diagnose problems. We do not use these records for advertising or to build visitor
        profiles.
      </p>

      <h2>Cookies</h2>
      <p>
        MIS does not set analytics or advertising cookies on this site. Three kinds of browser
        storage may still be involved:
      </p>
      <ul>
        <li>
          The optional 1995 mode stores its on-or-off setting and a local novelty counter in
          your browser. That information stays on your device and is not sent to MIS.
        </li>
        <li>Cloudflare may set cookies needed for security and bot protection.</li>
        <li>
          Cal.com may set its own cookies or browser storage when its booking calendar loads
          on the free consultation page.
        </li>
      </ul>
      <p>
        MIS does not use this storage for advertising. If you prefer not to load the Cal.com
        calendar, you can contact us by phone, email, or the contact form instead.
      </p>
      <p>
        Fathom does not set cookies or use local storage for analytics. Our Fathom script also
        honors your browser&rsquo;s Do Not Track setting.
      </p>

      <h2>Who else sees your information</h2>
      <p>These services are directly involved in operating this website:</p>
    </Prose>

    <div class="mt-6 flex max-w-[68ch] flex-col gap-3">
      {
        processors.map((p) => (
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 rounded-lg border border-line-soft bg-paper-panel px-5 py-4">
            <a
              href={p.href}
              rel="noopener nofollow"
              target="_blank"
              class="font-display text-base font-bold text-primary no-underline hover:underline"
            >
              {p.name}
            </a>
            <span class="text-[15px] text-ink-soft">{p.role}</span>
          </div>
        ))
      }
    </div>

    <Prose class="mt-8">
      <p>
        Form submissions delivered through Resend become ordinary business email and may be
        stored in the systems we use to manage correspondence. We do not sell or rent personal
        information, and we do not disclose it to unrelated companies for their marketing. We
        may disclose information when required by law or when necessary to protect the site,
        our business, or other people.
      </p>

      <h2>How long we keep it</h2>
      <p>
        We keep inquiries and other correspondence for as long as we reasonably need them to
        respond, maintain business records, or support an ongoing client relationship. Records
        connected to paid work may be kept longer for legal, tax, accounting, and contractual
        reasons. Cloudflare controls the retention of its technical and security logs under its
        own policies. Fathom retains the aggregate analytics available in our account under its
        service terms; those statistics are not connected to form contents or client records.
      </p>
      <p>
        If you would rather we did not keep an inquiry, ask us to delete it. We will honor the
        request unless we need to retain part of the record for a legal or business obligation.
      </p>

      <h2>Your choices</h2>
      <p>You can ask us to:</p>
      <ul>
        <li>Tell you what we hold about you</li>
        <li>Correct anything that is wrong</li>
        <li>Ask us to delete it</li>
        <li>Stop contacting you</li>
      </ul>
      <p>
        Email <a href={`mailto:${site.email}`}>{site.email}</a> or call
        <a href={site.phoneHref}>{site.phone}</a>. There is no form and no process. A person
        reads it and responds.
      </p>
      <p>
        Depending on where you live, you may have further rights under laws such as the
        GDPR or California&rsquo;s privacy laws. If you want to exercise one of those rights,
        contact us and describe the request.
      </p>

      <h2>Links to other websites</h2>
      <p>
        Our <a href="/portfolio">portfolio</a> links to client websites, and our
        <a href="/platforms">platforms</a> pages link to the companies whose software we use.
        Once you follow one of those links you are on someone else&rsquo;s site, under their
        privacy policy rather than ours.
      </p>

      <h2>Children</h2>
      <p>
        This site is not directed at children, and we do not knowingly collect information
        from anyone under 13.
      </p>

      <h2>Changes to this policy</h2>
      <p>
        If we change how we handle information in a way that matters, we will update this
        page and change the date at the top. We are not going to quietly rewrite it and hope
        nobody notices.
      </p>
    </Prose>
  </Section>

  <!-- Contact -->
  <Section variant="tint" width="full" divider={false}>
    <div class="mx-auto max-w-(--container-content) px-6 py-14 md:px-10 lg:py-16">
      <SectionHeader
        eyebrow="Questions about any of this"
        title="Ask us directly"
        lede="Privacy questions go to the same place everything else does. There is no separate department."
        class="mb-8"
      />
      <address class="not-italic text-[16.5px] leading-relaxed text-ink-soft" data-reveal>
        <strong class="block font-display text-lg font-bold text-ink">{site.legalName}</strong>
        {site.address.street}<br />
        {site.address.city}, {site.address.region} {site.address.postalCode}<br />
        <a href={site.phoneHref} class="font-bold text-primary no-underline hover:underline"
          >{site.phone}</a
        ><br />
        <a href={`mailto:${site.email}`} class="font-bold text-primary no-underline hover:underline"
          >{site.email}</a
        >
      </address>
    </div>
  </Section>
</Base>

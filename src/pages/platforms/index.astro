---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import Section from '../../components/Section.astro'
import SectionHeader from '../../components/SectionHeader.astro'
import PageHero from '../../components/PageHero.astro'
import Card from '../../components/Card.astro'
import CtaBand from '../../components/CtaBand.astro'

const all = await getCollection('platforms')

const recommended = all
  .filter((p) => p.data.stance !== 'migrate')
  .sort((a, b) => a.data.order - b.data.order)

const migrateFrom = all
  .filter((p) => p.data.stance === 'migrate')
  .sort((a, b) => a.data.order - b.data.order)

const CATEGORY_LABEL = {
  websites: 'Website platform',
  commerce: 'Ecommerce platform',
  marketing: 'Marketing platform',
  data: 'Application platform',
} as const
---

<Base
  title="Platforms We Build On — and the Ones We Don't | MIS, Inc."
  description="An honest account of the platforms we build on, the ones we partner with, and the ones we recommend moving away from — with our reasoning for each."
>
  <div class="border-b border-line">
    <PageHero
      eyebrow="Platforms"
      title="What we build on, and why"
      lede="We are not loyal to any platform. Here is where we actually stand on each one, including the popular ones we no longer recommend and what we suggest instead."
      ctas={[{ label: 'Book a free consultation', href: '/free-consultation' }]}
    />
  </div>

  <Section>
    <SectionHeader
      eyebrow="Recommended"
      title="Platforms we build on and partner with"
      lede="Each of these earns its place for a specific kind of project. The right one depends on your budget and who will maintain the site."
      class="mb-10"
    />

    <div class="grid gap-5 lg:grid-cols-3">
      {
        recommended.map((p) => (
          <Card
            variant="note"
            href={`/platforms/${p.id}`}
            tag={CATEGORY_LABEL[p.data.category]}
            title={p.data.name}
            blurb={p.data.summary}
            cta="Read our take"
          />
        ))
      }
    </div>
  </Section>

  {
    migrateFrom.length > 0 && (
      <Section variant="tint" width="full">
        <div class="mx-auto max-w-(--container-content) px-6 py-14 md:px-10 lg:py-20">
          <SectionHeader
            eyebrow="Our honest take"
            title="Platforms we usually move people off"
            lede="These are popular, and plenty of agencies will happily build on them. We would rather explain why we do not, and what we would do instead — including the cases where staying put is the right call."
            class="mb-10"
          />

          <div class="grid gap-5 lg:grid-cols-3">
            {migrateFrom.map((p) => (
              <Card
                variant="note"
                href={`/platforms/${p.id}`}
                tag={CATEGORY_LABEL[p.data.category]}
                title={p.data.name}
                blurb={p.data.verdict}
                cta="Why, and what instead"
              />
            ))}
          </div>
        </div>
      </Section>
    )
  }

  <Section divider={false}>
    <CtaBand
      title="Not sure which platform fits?"
      note="Tell us what your business needs the site to do. We will recommend the one that fits, even when it is the cheaper option."
    />
  </Section>
</Base>

---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import PageHero from '../../components/PageHero.astro';
import PlatformCard from '../../components/PlatformCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { PLATFORMS_BY_SLUG } from '../../lib/platforms';
import { breadcrumbs, collectionPage } from '../../lib/schema';

const all = await getCollection('platforms')
const migrations = (await getCollection('migrations')).sort(
  (a, b) => a.data.order - b.data.order,
)
const byOrder = (a: (typeof all)[number], b: (typeof all)[number]) =>
  a.data.order - b.data.order

const partners = all.filter((p) => p.data.stance === 'partner').sort(byOrder)
const own = all.filter((p) => p.data.stance === 'own').sort(byOrder)
const migrateFrom = all.filter((p) => p.data.stance === 'migrate').sort(byOrder)

const isWide = (slug: string) => Boolean(PLATFORMS_BY_SLUG[slug]?.wide)
const schema = [
  collectionPage({
    name: 'Platforms',
    description:
      'The platforms MIS, Inc. partners with, the products we built ourselves, and the ones we move clients off.',
    path: '/platforms',
    items: [...partners, ...own, ...migrateFrom].map((p) => ({
      name: p.data.name,
      href: `/platforms/${p.id}`,
    })),
  }),
  breadcrumbs([{ name: 'Platforms' }]),
]
---

<Base
  title="Our Platform Partners, and What We Migrate Away From | MIS, Inc."
  description="MIS, Inc. is a Certified Webflow Partner, a Square Online certified agency, and a Shopify, Mailchimp, and Ecwid partner. Here is what we build on, what we built ourselves, and what we move clients off."
  schema={schema}
>
  <div class="border-b border-line">
    <PageHero eyebrow="Platforms" title="Tools we rely on day in, day out" lede="We thoughtfully chose these tools because they are the best in the industry and went through their certification and partner programs, which means direct support channels, early access, and people to escalate to when something breaks on your site." ctas={[{ label: 'Book a free consultation', href: '/free-consultation' }]} layout="full" showMedia={false} />
  </div>

  <Section>
    <SectionHeader
      eyebrow="Certified partners"
      title="Platforms we have chosen to partner with"
      lede="Each of these is a deliberate commitment rather than a tool we happen to use. We keep the list short on purpose, because a partnership is only worth anything if we are genuinely expert in the platform."
      class="mb-10"
    />

    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        partners.map((p) => (
          <PlatformCard
            slug={p.id}
            name={p.data.name}
            icon={p.data.icon}
            wordmark={p.data.wordmark}
            summary={p.data.summary}
            credential={p.data.credential}
            wide={isWide(p.id)}
          />
        ))
      }
    </div>
  </Section>

  {
    own.length > 0 && (
      <Section variant="tint" width="full">
        <div class="mx-auto max-w-(--container-content) px-6 py-14 md:px-10 lg:py-20">
          <SectionHeader
            eyebrow="Built by us"
            title="Our own custom built platforms"
            lede="Two platforms we built ourselves when we didn’t find a solution that was a good fit for our clients."
            class="mb-10"
          />

          <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {own.map((p) => (
              <PlatformCard
                slug={p.id}
                name={p.data.name}
                icon={p.data.icon}
                wordmark={p.data.wordmark}
                summary={p.data.summary}
                credential={p.data.credential}
                wide={isWide(p.id)}
                cta="See what it does"
              />
            ))}
          </div>
        </div>
      </Section>
    )
  }

  {
    migrateFrom.length > 0 && (
      <Section>
        <SectionHeader
          eyebrow="Our honest take"
          title="Platforms we usually move people off"
          lede="These are popular, and plenty of agencies will happily build on them. We would rather explain why we do not, and what we would do instead, including the cases where staying put is the right call."
          class="mb-10"
        />

        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {migrateFrom.map((p) => (
            <PlatformCard
              slug={p.id}
              name={p.data.name}
              icon={p.data.icon}
              wordmark={p.data.wordmark}
              summary={p.data.verdict}
              wide={isWide(p.id)}
              cta="Why, and what instead"
            />
          ))}
        </div>

        {migrations.length > 0 && (
          <div class="mt-12 rounded-lg border border-line-soft bg-paper-panel p-7 shadow-card" data-reveal>
            <h3 class="mb-2 font-display text-xl font-bold text-ink">
              Are you ready to move your website? Migrating websites is routine work for us.
            </h3>
            <p class="mb-6 max-w-(--container-prose) text-ink-soft">
              Each guide covers what actually migrates, what you give up, how long it takes,
              and how your search rankings survive the switch, including the cases where our
              answer is that you should stay put.
            </p>
            <div class="flex flex-wrap gap-2.5">
              {migrations.map((m) => (
                <a
                  href={`/migrate/${m.id}`}
                  class="rounded-full border border-line-soft bg-paper px-4 py-2 text-sm font-extrabold text-ink-soft no-underline transition hover:border-primary/40 hover:text-primary"
                >
                  {m.data.title}
                </a>
              ))}
              <a
                href="/website-migrations"
                class="rounded-full border-[1.5px] border-primary/35 px-4 py-2 text-sm font-extrabold text-primary no-underline transition hover:bg-primary/5"
              >
                All migrations
              </a>
            </div>
          </div>
        )}
      </Section>
    )
  }

  <Section divider={false}>
    <CtaBand
      title="Not sure which platform fits?"
      note="Tell us what your business needs the site to do. We will recommend the one that fits, even when it is the cheaper option."
    />
  </Section>
</Base>

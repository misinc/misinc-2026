---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PageHero from '../components/PageHero.astro';
import PriceTable from '../components/PriceTable.astro';
import NextStep from '../components/NextStep.astro';
import CtaBand from '../components/CtaBand.astro';
import Testimonial from '../components/Testimonial.astro';
import { getCollection } from 'astro:content';
import { PRICE_TIERS, money, tier, PROJECT_FLOOR } from '../lib/pricing';
import { site, yearsInBusiness } from '../lib/site';

const work = await getCollection('work')
const quote = work.find((w) => w.id === 'peasant-pies')

const drivers = [
  {
    title: 'How many pages',
    body: 'The clearest driver. A five-page site is a different job from a thirty-page one, and most businesses need fewer pages than they first assume.',
  },
  {
    title: 'Who writes the content',
    body: 'If you supply the words and images, the project is faster and cheaper. If we write them, that is real work and it is priced in. Either is fine. Deciding early is what matters.',
  },
  {
    title: 'Custom functionality',
    body: 'Booking systems, member logins, calculators, integrations with software you already run. Anything that has to do something rather than show something.',
  },
  {
    title: 'Migrating existing content',
    body: 'Moving a hundred blog posts across, preserving URLs so rankings survive, is significant work. Starting fresh with ten pages is not.',
  },
  {
    title: 'E-commerce complexity',
    body: 'Twenty products with one option each is straightforward. Hundreds with variants, shipping rules, and inventory sync is not.',
  },
  {
    title: 'How fast you need it',
    body: 'Normal timelines cost normal money. A hard deadline that means reordering other work costs more, and we will say so rather than quietly missing it.',
  },
]

const included = [
  'A fixed price agreed before any work starts',
  'Design and build, tested on real phones and tablets',
  'Mobile-first, because that is where most of your visitors are',
  'Accessibility built in, not retrofitted',
  'SEO foundations: titles, descriptions, structured data, speed',
  'AI-search readiness, at no extra charge',
  'Google Business Profile setup or review',
  'Training so you can manage what you should manage',
  'Ownership of your domain, content, and accounts',
]

const faqs = [
  {
    q: 'How much does a website cost in Albuquerque?',
    a: `Our projects start at ${money(PROJECT_FLOOR)} for a straightforward five to eight page site, ${money(tier('business').from)} for a site with a CMS you can update yourself, and ${money(tier('ecommerce').from)} for an online store. Custom software and AI work starts at ${money(tier('software').from)}. What moves the figure is page count, whether we write the content, and any custom functionality.`,
  },
  {
    q: 'Do you charge hourly or a fixed price?',
    a: 'Fixed price, agreed before work starts. You get a written proposal with a number, and that is the number you pay. We would rather absorb an occasional overrun than send a surprise invoice, and one of our clients wrote a review specifically about that.',
  },
  {
    q: 'Are there ongoing costs?',
    a: `Hosting and care starts at ${money(tier('care').from)} a month, which covers hosting, monitoring, backups, and small content changes. Marketing and SEO work is separate, starting at ${money(tier('marketing').from)} a month. Neither is compulsory, and you can host elsewhere and manage the site yourself if you prefer.`,
  },
  {
    q: 'What if my budget is below your starting price?',
    a: 'Tell us anyway. Sometimes the right answer is a smaller first phase, and sometimes it is that a template service will genuinely serve you better for now, and we will say so. What we will not do is quietly cut corners to hit a number.',
  },
  {
    q: 'Do you offer payment plans?',
    a: 'Projects are normally split across milestones rather than paid up front, so the cost spreads across the build. Talk to us about what works for your cash flow.',
  },
  {
    q: 'Do nonprofits get different pricing?',
    a: 'Tell us about your budget when you get in touch. A good portion of our work is with New Mexico nonprofits, and we would rather scope a project to fit what you have than quote something out of reach.',
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}

// Priced offers, so assistants and search engines can read the figures directly
// rather than inferring them from prose.
const offerSchema = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Web design and development pricing',
  provider: { '@id': `${site.url}/#organization` },
  itemListElement: PRICE_TIERS.map((t) => ({
    '@type': 'Offer',
    name: t.name,
    description: t.summary,
    priceCurrency: 'USD',
    price: t.from,
    priceSpecification: {
      '@type': 'PriceSpecification',
      minPrice: t.from,
      priceCurrency: 'USD',
      ...(t.unit === 'month' && { billingIncrement: 1, unitCode: 'MON' }),
    },
    url: `${site.url}${t.href}`,
  })),
}
---

<Base
  title="Web Design Pricing in Albuquerque: What It Actually Costs | MIS, Inc."
  description={`What a website actually costs in Albuquerque. Our projects start at ${money(PROJECT_FLOOR)}, with clear ranges by type and an honest explanation of what moves the price up or down.`}
  schema={[faqSchema, offerSchema]}
>
  <div class="border-b border-line">
    <PageHero eyebrow="Pricing guide" title="What a website actually costs" lede={`Most agencies will not tell you until you are on a call. Here are our real starting prices, what moves them, and what is included, so you can work out whether we are in your range before spending an hour finding out.`} ctas={[
        { label: 'Book a free consultation', href: '/free-consultation' },
        { label: 'See our projects', href: '/portfolio', variant: 'ghost' },
      ]} layout="full" showMedia={false} />
  </div>

  <!-- The numbers -->
  <Section>
    <SectionHeader
      eyebrow="Starting prices"
      title="Our prices, plainly"
      lede="Every project is quoted individually, but these are the floors. If your project is simpler than a tier suggests, we will say so and quote less."
      class="mb-10"
    />
    <PriceTable />

    <p class="mt-8 max-w-(--container-prose) text-sm text-ink-muted">
      Prices are in US dollars and exclude third-party costs you would pay
      regardless: domain registration, platform subscriptions, stock photography,
      and payment processing fees. We will list those separately in your proposal
      so you can see the full running cost, not just ours.
    </p>
  </Section>

  <!-- What moves the price -->
  <Section variant="tint" width="full">
    <div class="mx-auto max-w-(--container-content) px-6 py-14 md:px-10 lg:py-20">
      <SectionHeader
        eyebrow="What moves the number"
        title="Why two websites can cost very differently"
        lede="These six things account for nearly all the variation. Knowing them lets you shape the project around your budget rather than the other way round."
        class="mb-10"
      />
      <div class="grid gap-6 md:grid-cols-2">
        {
          drivers.map((d, i) => (
            <div class="flex gap-4" data-reveal>
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-paper-panel font-display text-[15px] font-bold tabular-nums text-primary">
                {i + 1}
              </span>
              <div>
                <h3 class="mb-1 font-display text-base font-bold text-ink">{d.title}</h3>
                <p class="text-sm text-ink-soft">{d.body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- Included -->
  <Section>
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_320px]">
      <div>
        <SectionHeader
          eyebrow="Included as standard"
          title="What every project comes with"
          lede="These are not upsells. They are what we consider the minimum for a website worth paying for."
          class="mb-8"
        />
        <ul class="flex list-none flex-col gap-3 p-0" data-reveal>
          {
            included.map((i) => (
              <li class="relative pl-7 text-[15.5px] text-ink-soft">
                <span class="absolute left-0 top-[3px] font-bold text-accent">&check;</span>
                {i}
              </li>
            ))
          }
        </ul>
      </div>

      <aside>
        <div class="rounded-lg border border-line-soft bg-paper-panel p-6 shadow-card" data-reveal>
          <h2 class="mb-2 font-display text-lg font-bold text-ink">No surprise invoices</h2>
          <p class="text-sm text-ink-soft">
            The price is agreed before work starts. If a project grows mid-way, we have been
            known to absorb it rather than re-invoice.
          </p>
          <p class="mt-3 text-sm text-ink-soft">
            {yearsInBusiness} years in, we would rather keep the relationship than win the
            argument.
          </p>
        </div>
      </aside>
    </div>
  </Section>

  {
    quote?.data.testimonial && (
      <Section variant="tint" width="full">
        <div class="mx-auto max-w-(--container-content) px-6 py-14 md:px-10 lg:py-16">
          <Testimonial
            quote={quote.data.testimonial.quote}
            attribution={quote.data.testimonial.attribution}
            href={`/works/${quote.id}`}
          />
        </div>
      </Section>
    )
  }

  <!-- Lowering the cost -->
  <Section>
    <SectionHeader
      eyebrow="If the budget is tight"
      title="How to spend less, honestly"
      class="mb-8"
    />
    <div class="max-w-[68ch] text-ink-soft">
      <p class="mb-4">
        <strong class="text-ink">Write your own content.</strong> This is the single biggest
        lever. Nobody knows your business better, and a rough draft we edit costs far less than
        us starting from nothing.
      </p>
      <p class="mb-4">
        <strong class="text-ink">Start smaller.</strong> Launch the five pages that matter and
        add the rest once the site is earning. A smaller site that exists beats a bigger one
        still being written.
      </p>
      <p class="mb-4">
        <strong class="text-ink">Use your own photographs.</strong> Real photographs of your
        premises, team, and work outperform stock imagery anyway.
      </p>
      <p class="mb-4">
        <strong class="text-ink">Skip functionality you are not sure about.</strong> Booking
        systems and member areas are easy to want and expensive to build. Add them when you
        know you need them.
      </p>
      <p>
        <strong class="text-ink">Fix rather than rebuild, if that is the honest answer.</strong>
        {' '}Sometimes a few hours of repair does what a rebuild would. We will tell you when
        that is the case, even though it is a smaller invoice for us.
      </p>
    </div>
  </Section>

  <!-- FAQ -->
  <Section variant="tint" width="full">
    <div class="mx-auto max-w-(--container-content) px-6 py-14 md:px-10 lg:py-20">
      <SectionHeader eyebrow="Common questions" title="About pricing" class="mb-10" />
      <div class="max-w-[820px]">
        {
          faqs.map((f, i) => (
            <details class="group border-b border-line-soft py-1" open={i === 0} data-reveal>
              <summary class="relative cursor-pointer list-none py-4 pr-10 font-display text-[19px] font-semibold text-ink hover:text-primary">
                {f.q}
                <span class="pointer-events-none absolute right-2 top-1/2 -mt-[7px] h-[11px] w-[11px] rotate-45 border-b-[2.5px] border-r-[2.5px] border-primary transition-transform group-open:-mt-[3px] group-open:rotate-[-135deg]" />
              </summary>
              <p class="m-0 max-w-[68ch] pb-5 text-[15.5px] text-ink-soft">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </Section>

  <Section>
    <NextStep
      title="Get a real number for your project"
      text="Tell us what you need and we will give you a fixed price, not a range. The consultation is free and you will get honest recommendations either way, including if the answer is that you need less than you thought."
    />
  </Section>

  <Section divider={false}>
    <CtaBand
      title="Ready to talk numbers?"
      note="A short call, a clear scope, and a fixed price before anything starts."
      ctaHref="/start-a-project"
    />
  </Section>
</Base>

---
import Base from '../layouts/Base.astro'
import Marquee from '../components/Marquee.astro'
import { site, yearsInBusiness } from '../lib/site'

const facts = [
  { value: '1995', label: 'Founded in Albuquerque' },
  { value: String(yearsInBusiness), count: yearsInBusiness, label: 'Years in continuous practice' },
  { value: '500+', count: 500, suffix: '+', label: 'Projects delivered' },
  { value: '20+', count: 20, suffix: '+', label: 'Years with our longest clients' },
]

const services = [
  {
    tag: 'Websites',
    title: 'Websites that work',
    blurb: 'Clean, fast sites built to bring you customers — not just to look good in a portfolio.',
    points: ['Design & development', 'SEO + AI-search readiness', 'Ongoing care & hosting'],
    href: '/services/web-design',
    cta: 'Explore web design',
  },
  {
    tag: 'Software',
    title: 'Custom software',
    blurb:
      "Portals, integrations, and internal tools that remove the busywork your off-the-shelf apps can't.",
    points: ['Web applications & portals', 'Integrations & automations', 'Internal tools'],
    href: '/services/custom-software',
    cta: 'Explore custom software',
  },
  {
    tag: 'AI',
    title: 'AI, put to work',
    blurb:
      "Practical AI consulting and custom agents — the same level-headed judgment we've applied to every web shift since 1995.",
    points: ['AI strategy for small teams', 'Custom AI agents', 'Workflow automation'],
    href: '/services/ai-consulting',
    cta: 'Explore AI services',
  },
]

const eras = [
  { year: '1995', title: 'The dial-up web', note: 'First business websites, hand-built.' },
  { year: '2004', title: 'CMS & ecommerce', note: 'Sites owners could update themselves.' },
  { year: '2012', title: 'Mobile-first', note: 'Responsive design becomes table stakes.' },
  { year: '2020', title: 'Modern platforms', note: 'Webflow, headless builds, integrations.' },
  {
    year: '2026',
    title: 'The AI web',
    note: 'Agents, automation, and being found by answer engines.',
  },
]

const steps = [
  {
    title: 'Book a free strategy call',
    note: "Tell us what's working and what isn't. You'll get honest recommendations either way.",
  },
  {
    title: 'Get a clear plan and price',
    note: "A plain-language proposal — what we'll build, what it costs, when it ships.",
  },
  {
    title: 'Launch, then keep improving',
    note: 'We stay on after launch to keep your site fast, secure, and earning its keep.',
  },
]

const faqs = [
  {
    q: 'How much does a website cost in Albuquerque?',
    a: 'Most small business websites we build land between $5,000 and $20,000, depending on page count, custom functionality, and whether you need ecommerce or integrations. Nonprofits and very small businesses often start lower. We publish a full pricing guide, and every proposal states the number before work begins — no hourly surprises.',
  },
  {
    q: 'What platforms do you build on?',
    a: 'We build primarily on Webflow, Square Online, WordPress, and Astro for custom static sites, plus Supabase for applications that need a database. We pick the platform that fits your budget and who will maintain it — not the one that locks you into us.',
  },
  {
    q: 'Do you work with clients outside New Mexico?',
    a: "Yes. We've worked with clients across the U.S. and internationally since 1995. Our focus now is on local Albuquerque and New Mexico businesses and nonprofits, but distance has never been the obstacle people expect.",
  },
  {
    q: 'Can you help my site get found by AI assistants like ChatGPT?',
    a: "Yes — it's called Answer Engine Optimization, and it's an extension of good SEO: clear structure, structured data, factual content that answers real questions, and a site fast enough to be crawled well. We build it into every project now rather than selling it separately.",
  },
  {
    q: 'What does AI consulting actually mean for a small business?',
    a: 'Usually one of three things: automating a repetitive task that eats hours each week, building a custom agent that handles routine customer questions, or simply helping you decide which AI tools are worth paying for. We start with what is slow in your business, not with the technology.',
  },
  {
    q: "Do you maintain sites you didn't build?",
    a: "Often, yes. We take over care and hosting for existing WordPress, Webflow, and Square sites, and we also handle migrations off platforms that have been discontinued or outgrown. We'll audit first and tell you honestly whether maintaining or rebuilding is the better use of your money.",
  },
]

const guides = [
  {
    tag: 'Pricing',
    title: 'What a website really costs in Albuquerque',
    blurb: 'Honest ranges for small business sites, and what actually drives the number up or down.',
    href: '/albuquerque-web-design-pricing-guide',
  },
  {
    tag: 'Local SEO',
    title: 'How to choose an Albuquerque SEO company',
    blurb: 'What to ask, what to avoid, and how to tell real local expertise from a sales pitch.',
    href: '/blog/albuquerque-seo-company',
  },
  {
    tag: 'AI & search',
    title: 'Getting found when customers ask AI',
    blurb: 'What changes when people ask an assistant instead of typing into a search box.',
    href: '/blog',
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}
---

<Base
  title="Albuquerque Web Design, Custom Software & AI | MIS, Inc. — Since 1995"
  description={site.description}
  schema={faqSchema}
>
  <!-- Hero -->
  <div class="mx-auto max-w-(--container-content) px-6 md:px-10">
    <section class="grid items-center gap-9 py-14 lg:grid-cols-[1.08fr_0.92fr] lg:py-[76px]">
      <div>
        <span
          class="text-xs font-bold uppercase tracking-(--tracking-label) text-primary"
        >
          Web design &middot; Custom software &middot; Practical AI
        </span>

        <h1 class="my-5 text-4xl font-bold text-ink">
          The web keeps changing.<br />
          <span id="type-a">We&rsquo;ve been building it </span><span
            id="type-b"
            class="text-primary">since&nbsp;1995.</span
          ><span class="caret" id="caret" aria-hidden="true"></span>
        </h1>

        <p class="mb-7 max-w-(--container-prose) text-lg text-ink-soft">
          MIS, Inc. is a boutique web design and development agency based in Albuquerque, New
          Mexico. We build websites, custom software, and practical AI for small businesses and
          nonprofits &mdash; here at home and around the world.
        </p>

        <div class="flex flex-wrap items-center gap-3.5">
          <a
            href="/free-consultation"
            class="inline-block rounded-full bg-accent px-5 py-3 text-[15px] font-extrabold text-white no-underline shadow-button transition hover:-translate-y-px hover:bg-accent-dark"
          >
            Book a free strategy call
          </a>
          <a
            href="/portfolio"
            class="inline-block rounded-full border-[1.5px] border-primary/35 px-5 py-3 text-[15px] font-extrabold text-primary no-underline transition hover:bg-primary/5"
          >
            See our work
          </a>
        </div>

        <p class="mt-4 text-sm font-semibold text-ink-muted">
          A real conversation with the people who&rsquo;ll actually do the work.
        </p>
      </div>

      <figure class="m-0 overflow-hidden rounded-md border border-line-soft shadow-media">
        <div class="relative aspect-[16/10] lg:aspect-[4/5]">
          <!-- TODO(video): when compressing this to ~1.5 MB with ffmpeg, export a
               first-frame poster at the same time and add poster="/img/anniversary-balloon-poster.jpg".
               Currently 4.8 MB, which is the heaviest asset on the page. -->
          <video
            class="absolute inset-0 h-full w-full object-cover"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="The MIS, Inc. hot air balloon rising over the Albuquerque International Balloon Fiesta"
          >
            <source src="/video/anniversary-balloon.mp4" type="video/mp4" />
          </video>
          <figcaption
            class="absolute inset-x-0 bottom-0 bg-linear-to-t from-ink/75 to-transparent px-4 pb-3.5 pt-6 text-xs font-bold uppercase tracking-(--tracking-label) text-[#fff6e6]"
          >
            Our 30th anniversary balloon over Albuquerque
          </figcaption>
        </div>
      </figure>
    </section>
  </div>

  <!-- Facts -->
  <div class="border-y border-line bg-paper-tint">
    <div class="grid grid-cols-2 lg:grid-cols-4">
      {
        facts.map((f) => (
          <div class="px-5 py-6 text-center" data-reveal>
            <b
              class="block font-display text-[32px] font-bold tabular-nums text-primary"
              data-count={f.count}
              data-suffix={f.suffix}
            >
              {f.value}
            </b>
            <span class="text-xs font-bold uppercase tracking-(--tracking-label) text-ink-muted">
              {f.label}
            </span>
          </div>
        ))
      }
    </div>
  </div>

  <Marquee />

  <div class="mx-auto max-w-(--container-content) px-6 md:px-10">
    <!-- Services -->
    <section id="services" class="border-b border-line py-14 lg:py-20">
      <div class="mb-10 max-w-[640px]" data-reveal>
        <span class="text-xs font-bold uppercase tracking-(--tracking-label) text-primary">
          Services
        </span>
        <h2 class="my-3.5 text-3xl font-bold text-ink">Three ways we help</h2>
        <p class="max-w-(--container-prose) text-ink-soft">
          Everything under one roof, from your first website to your first AI agent &mdash; so
          you&rsquo;re never coordinating three vendors who don&rsquo;t talk to each other.
        </p>
      </div>

      <div class="grid gap-5 lg:grid-cols-3">
        {
          services.map((s) => (
            <div
              class="group flex flex-col gap-3.5 rounded-lg border border-line-soft bg-paper-panel p-7 shadow-card transition hover:-translate-y-[3px] hover:shadow-card-hover"
              data-reveal
            >
              <span class="text-[11.5px] font-extrabold uppercase tracking-(--tracking-label) text-accent-dark">
                {s.tag}
              </span>
              <h3 class="text-xl font-bold text-ink">{s.title}</h3>
              <p class="text-[15.5px] text-ink-soft">{s.blurb}</p>
              <ul class="flex list-none flex-col gap-2 p-0">
                {s.points.map((p) => (
                  <li class="relative pl-5 text-sm font-semibold text-ink-soft">
                    <span class="absolute left-0 top-2 h-2 w-2 rounded-full bg-accent" />
                    {p}
                  </li>
                ))}
              </ul>
              <a
                href={s.href}
                class="mt-auto inline-flex items-center gap-2 pt-1.5 text-[15px] font-extrabold text-primary no-underline"
              >
                {s.cta}
                <span
                  class="arrow transition-transform group-hover:translate-x-1"
                  aria-hidden="true"
                >
                  &rarr;
                </span>
              </a>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Eras -->
    <section id="about" class="border-b border-line py-14 lg:py-20">
      <div class="mb-10 max-w-[640px]" data-reveal>
        <span class="text-xs font-bold uppercase tracking-(--tracking-label) text-primary">
          Since 1995
        </span>
        <h2 class="my-3.5 text-3xl font-bold text-ink">
          We&rsquo;ve built through every era of the web
        </h2>
        <p class="max-w-(--container-prose) text-ink-soft">
          Most agencies are younger than some of our client relationships. Every few years the web
          reinvents itself &mdash; our job has always been to figure out what actually matters and
          put it to work for you.
        </p>
      </div>

      <div
        class="grid border-l-2 border-primary lg:grid-cols-5 lg:border-l-0 lg:border-t-2"
      >
        {
          eras.map((e) => (
            <div class="relative pb-6 pl-6 lg:pb-0 lg:pl-0 lg:pr-4 lg:pt-6" data-reveal>
              <span class="absolute left-[-9px] top-1 h-3 w-3 rounded-full border-[3px] border-primary bg-paper lg:left-0 lg:top-[-7px]" />
              <b class="block font-display text-[23px] font-bold tabular-nums text-primary">
                {e.year}
              </b>
              <em class="my-1 block text-[15px] font-extrabold not-italic text-ink">{e.title}</em>
              <p class="max-w-[55ch] text-sm leading-relaxed text-ink-muted lg:max-w-[24ch]">
                {e.note}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Process -->
    <section class="border-b border-line py-14 lg:py-20">
      <div class="grid gap-9 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14">
        <div data-reveal>
          <span class="text-xs font-bold uppercase tracking-(--tracking-label) text-primary">
            Albuquerque, New Mexico
          </span>
          <h2 class="my-3.5 text-3xl font-bold text-ink">Rooted here, working anywhere</h2>
          <div class="max-w-(--container-prose) text-ink-soft">
            <p class="mb-4">
              We&rsquo;ve spent {yearsInBusiness} years working with clients around the world, and what
              we want most now is to put that experience to work close to home &mdash; for the small
              businesses and nonprofits that make New Mexico what it is.
            </p>
            <p>
              That means straight answers, fair pricing, and a partner you can actually meet for
              coffee. No account managers, no handoffs &mdash; you work directly with the people
              building your project.
            </p>
          </div>
        </div>

        <div class="flex flex-col">
          {
            steps.map((s, i) => (
              <div
                class="flex items-start gap-4 py-5 not-first:border-t not-first:border-line-soft"
                data-reveal
              >
                <span class="grid h-[38px] w-[38px] shrink-0 place-items-center rounded-full bg-paper-surface font-display text-base font-bold text-primary">
                  {i + 1}
                </span>
                <div>
                  <b class="mb-1 block text-[16.5px] font-extrabold text-ink">{s.title}</b>
                  <p class="text-sm text-ink-soft">{s.note}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="border-b border-line py-14 lg:py-20">
      <div class="mb-10 max-w-[640px]" data-reveal>
        <span class="text-xs font-bold uppercase tracking-(--tracking-label) text-primary">
          Common questions
        </span>
        <h2 class="my-3.5 text-3xl font-bold text-ink">Straight answers, before you call</h2>
        <p class="max-w-(--container-prose) text-ink-soft">
          The questions we&rsquo;re asked most often &mdash; answered plainly, so you can decide
          whether we&rsquo;re a fit before you spend a minute on the phone.
        </p>
      </div>

      <div class="max-w-[800px]">
        {
          faqs.map((f, i) => (
            <details class="group border-b border-line-soft py-1" open={i === 0} data-reveal>
              <summary class="relative cursor-pointer list-none py-4 pr-10 font-display text-[19px] font-semibold text-ink hover:text-primary">
                {f.q}
                <span class="pointer-events-none absolute right-2 top-1/2 -mt-[7px] h-[11px] w-[11px] rotate-45 border-b-[2.5px] border-r-[2.5px] border-primary transition-transform group-open:-mt-[3px] group-open:rotate-[-135deg]" />
              </summary>
              <p class="m-0 max-w-[68ch] pb-5 text-[15.5px] text-ink-soft">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- Guides -->
    <section class="border-b border-line py-14 lg:py-20">
      <div class="mb-10 max-w-[640px]" data-reveal>
        <span class="text-xs font-bold uppercase tracking-(--tracking-label) text-primary">
          Notes
        </span>
        <h2 class="my-3.5 text-3xl font-bold text-ink">
          Guides from {yearsInBusiness} years of practice
        </h2>
        <p class="max-w-(--container-prose) text-ink-soft">
          Practical writing for New Mexico business owners &mdash; what things cost, what&rsquo;s
          worth doing, and what to ignore.
        </p>
      </div>

      <div class="grid gap-5 lg:grid-cols-3">
        {
          guides.map((g) => (
            <a
              href={g.href}
              class="flex flex-col gap-2.5 rounded-lg border border-line-soft bg-paper-panel p-6 no-underline transition hover:-translate-y-[3px] hover:shadow-card-hover"
              data-reveal
            >
              <span class="text-[11.5px] font-extrabold uppercase tracking-(--tracking-label) text-ink-muted">
                {g.tag}
              </span>
              <h3 class="text-lg font-bold leading-tight text-ink">{g.title}</h3>
              <p class="text-sm text-ink-soft">{g.blurb}</p>
              <span class="mt-auto pt-2 text-sm font-extrabold text-primary">
                Read the guide &rarr;
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- CTA -->
    <section class="py-14 lg:py-20">
      <div
        class="flex flex-wrap items-center justify-between gap-7 rounded-lg bg-linear-to-br from-primary to-primary-dark px-7 py-10 text-[#fff3de] md:px-12 md:py-14"
        data-reveal
      >
        <div>
          <h2 class="mb-2 text-2xl font-bold text-paper-panel">
            Let&rsquo;s talk about your website.
          </h2>
          <p class="text-[15.5px] font-semibold text-[#f3cfa4]">
            No pressure. Clear recommendations. {yearsInBusiness} years of seeing what works.
          </p>
        </div>
        <a
          href="/free-consultation"
          class="inline-block rounded-full bg-accent px-5 py-3 text-[15px] font-extrabold text-white no-underline shadow-button transition hover:-translate-y-px hover:bg-accent-dark"
        >
          Book a free strategy call
        </a>
      </div>
    </section>
  </div>

  <script>
    // Hero typewriter. Skipped entirely under reduced motion — the headline is
    // already in the DOM, so it simply renders complete.
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const a = document.getElementById('type-a')
    const b = document.getElementById('type-b')
    const caret = document.getElementById('caret')
    const h1 = a?.closest('h1')

    if (!reduced && a && b && caret && h1) {
      const textA = a.textContent ?? ''
      const textB = b.textContent ?? ''
      a.textContent = ''
      b.textContent = ''
      h1.classList.add('typing')

      let i = 0
      const total = textA.length + textB.length
      const tick = () => {
        i++
        if (i <= textA.length) {
          a.textContent = textA.slice(0, i)
          a.parentNode?.insertBefore(caret, b)
        } else {
          a.textContent = textA
          b.textContent = textB.slice(0, i - textA.length)
          b.parentNode?.appendChild(caret)
        }
        if (i < total) setTimeout(tick, 36)
        else setTimeout(() => h1.classList.remove('typing'), 1800)
      }
      tick()
    }
  </script>
</Base>

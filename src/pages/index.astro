---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Marquee from '../components/Marquee.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/FaqList.astro';
import WorkCard from '../components/WorkCard.astro';
import PageHero from '../components/PageHero.astro';
import ServicesMarquee from '../components/ServicesMarquee.astro';
import Timeline from '../components/Timeline.astro';
import Testimonial from '../components/Testimonial.astro';
import { site, yearsInBusiness } from '../lib/site';

const facts = [
  { value: '1995', label: 'Founded in Albuquerque' },
  { value: String(yearsInBusiness), count: yearsInBusiness, label: 'Years in continuous practice' },
  { value: '500+', count: 500, suffix: '+', label: 'Websites built' },
  { value: '20+', count: 20, suffix: '+', label: 'Years with our longest clients' },
]

// Featured services come from the content collection — one per pillar, so the
// home page cannot drift out of sync with /services.
const allServices = await getCollection('services')
const featured = ['web-design', 'custom-software', 'ai-consulting']
  .map((slug) => allServices.find((x) => x.id === slug))
  .filter((x) => x !== undefined)

// Featured case studies and client quotes, both straight from the work
// collection so the home page always reflects the real portfolio.
const allWork = await getCollection('work')

// FAQs come from the shared collection, filtered to the ones flagged for this
// page — so the copy lives in exactly one place.
const faqs = (await getCollection('faqs'))
  .filter((f) => f.data.showOn.includes('home'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 5)
const featuredWork = allWork
  .filter((w) => w.data.featured)
  .sort((a, b) => b.data.year - a.data.year || (a.data.order ?? 999) - (b.data.order ?? 999))
  .slice(0, 6)
const quotes = allWork
  .filter((w) => w.data.testimonial)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 2)

const steps = [
  {
    title: 'Tell us what you want to accomplish',
    note: 'Book a consultation if you want to talk it through, or use the project form if you are ready to send the details.',
  },
  {
    title: 'Get a clear plan and price',
    note: 'Once the scope is clear, we’ll put the work, price, and schedule in writing.',
  },
  {
    title: 'Choose what happens after launch',
    note: 'If you need ongoing help, we can provide hosting, maintenance, SEO, and continued improvements.',
  },
]

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: site.url,
  name: site.name,
  publisher: { '@id': `${site.url}/#organization` },
}
---

<Base
  title="Albuquerque Web Design, Software & AI | MIS, Inc."
  description={site.description}
  schema={homeSchema}
>
  <!-- Hero -->
  <PageHero eyebrow="Web design · Custom software · Practical AI" title="Your trusted partner " typed={{ text:'', highlight: 'since 1995' }} lede="MIS, Inc. is a boutique web design and development studio based in Albuquerque, New Mexico. We design and build websites, develop custom software, and implement practical AI for small businesses and nonprofits, here at home and around the world." media={{
      type: 'video',
      src: '/video/anniversary-balloon.mp4',
      poster: '/img/anniversary-balloon-poster.avif',
      caption: '',
      alt: 'The MIS, Inc. hot air balloon rising over the Albuquerque International Balloon Fiesta (AI generated)',
      desktopTransform: 'translateX(18%) scale(1.4)',
    }} ctas={[
      { label: 'Book a free consultation', href: '/free-consultation' },
      { label: 'See our projects', href: '/portfolio', variant: 'ghost' },
    ]} layout="background" overlayOpacity={40} contrastPanel>
    <ServicesMarquee slot="edge" />
  </PageHero>

  <!-- Facts -->
  <div class="border-y border-line bg-paper-tint">
    <div class="grid grid-cols-2 lg:grid-cols-4">
      {
        facts.map((f) => (
          <div class="px-5 py-6 text-center" data-reveal>
            <b
              class="block font-display text-[32px] font-bold tabular-nums text-primary"
              data-count={f.count}
              data-suffix={f.suffix}
            >
              {f.value}
            </b>
            <span class="text-xs font-bold uppercase tracking-(--tracking-label) text-ink-muted">
              {f.label}
            </span>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Services -->
  <Section id="services">
    <SectionHeader eyebrow="Services" title="Our work falls into three areas" lede="Websites, custom software, and practical AI. Some clients need one. Others need a combination." class="mb-10" />

    <div class="grid gap-5 lg:grid-cols-3">
      {
        featured.map((s) => (
          <Card
            variant="service"
            tag={s.data.title}
            title={s.data.heading}
            blurb={s.data.summary}
            bullets={s.data.highlights}
            href={`/services/${s.id}`}
            cta={`Explore ${s.data.title.toLowerCase()}`}
          />
        ))
      }
    </div>

    <div class="mt-10">
      <Button href="/services" variant="ghost">See all services</Button>
    </div>
  </Section>

  <Marquee />

  <!-- Process -->
  <Section>
    <SectionHeader
      eyebrow="How we work"
      title="From first conversation to launch"
      lede="Book a free consultation or send us the project details. If the project is a fit, we define the scope, agree on a fixed price, and build it. Ongoing help is available after launch when you need it."
      class="mb-10"
    />

    <div class="grid gap-5 lg:grid-cols-3">
      {
        steps.map((s, i) => (
          <div
            class="flex items-start gap-4 rounded-lg border border-line-soft bg-paper-panel p-6 shadow-card"
            data-reveal
          >
            <span class="grid h-[38px] w-[38px] shrink-0 place-items-center rounded-full bg-paper-surface font-display text-base font-bold text-primary">
              {i + 1}
            </span>
            <div>
              <b class="mb-1 block text-[16.5px] font-extrabold text-ink">{s.title}</b>
              <p class="text-sm text-ink-soft">{s.note}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-8 flex flex-wrap gap-3.5">
      <Button href="/start-a-project">Start a project</Button>
      <Button href="/free-consultation" variant="ghost">Book a free consultation</Button>
    </div>
  </Section>

  <!-- Eras -->
  <Section id="about">
    <SectionHeader eyebrow="Since 1995" title="From dial-up websites to practical AI" lede={`We have spent ${yearsInBusiness} years adapting to changes in how websites are built, managed, and found. The tools keep changing. Our job is to understand which changes will help our clients and which ones can be ignored.`} class="mb-10" />

    <Timeline />
  </Section>

  <!-- Work -->
  <Section id="work">
    <SectionHeader
      eyebrow="Selected projects"
      title="Selected projects"
      lede="Websites, stores, and software shaped around what each client needed. The case notes explain the important decisions, the work MIS contributed, and the relationships behind it."
      class="mb-10"
    />

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        featuredWork.map((w) => (
          <WorkCard
            slug={w.id}
            title={w.data.title}
            client={w.data.client}
            summary={w.data.summary}
            category={w.data.category}
            image={w.data.cardImage ?? w.data.image}
            imageAlt={w.data.imageAlt}
            hasTestimonial={Boolean(w.data.testimonial)}
          />
        ))
      }
    </div>

    <div class="mt-10">
      <Button href="/portfolio" variant="ghost">See all our projects</Button>
    </div>
  </Section>

  <!-- Testimonials -->
  {
    quotes.length > 0 && (
      <Section variant="tint" width="full">
        <div class="mx-auto max-w-(--container-content) px-6 py-14 md:px-10 lg:py-20">
          <SectionHeader eyebrow="In their words" title="What clients say" lede="A few testimonials from our clients" class="mb-10" />
          <div class="grid gap-6 lg:grid-cols-2">
            {quotes.map((w) => (
              <Testimonial
                quote={w.data.testimonial!.quote}
                attribution={w.data.testimonial!.attribution}
                href={`/works/${w.id}`}
              />
            ))}
          </div>
        </div>
      </Section>
    )
  }


  <!-- FAQ -->
  <Section id="faq">
    <SectionHeader eyebrow="Common questions" title="Straight answers, before you call" lede="The questions we are asked most often, answered plainly so you can decide whether we are a fit before you spend a minute on the phone." class="mb-10" />
    <FaqList items={faqs} openFirst />
    <p class="mt-8">
      <a href="/faq" class="text-[15px] font-extrabold text-primary no-underline hover:underline">
        See all frequently asked questions &rarr;
      </a>
    </p>
  </Section>

  <!-- CTA -->
  <Section divider={false}>
    <CtaBand />
  </Section>

</Base>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Marquee from '../components/Marquee.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/FaqList.astro';
import WorkCard from '../components/WorkCard.astro';
import Timeline from '../components/Timeline.astro';
import Testimonial from '../components/Testimonial.astro';
import { site, yearsInBusiness } from '../lib/site';

const facts = [
  { value: '1995', label: 'Founded in Albuquerque' },
  { value: String(yearsInBusiness), count: yearsInBusiness, label: 'Years in continuous practice' },
  { value: '500+', count: 500, suffix: '+', label: 'Websites built' },
  { value: '20+', count: 20, suffix: '+', label: 'Years with our longest clients' },
]

// Featured services come from the content collection — one per pillar, so the
// home page cannot drift out of sync with /services.
const allServices = await getCollection('services')
const featured = ['web-design', 'custom-software', 'ai-consulting']
  .map((slug) => allServices.find((x) => x.id === slug))
  .filter((x) => x !== undefined)

// Featured case studies and client quotes, both straight from the work
// collection so the home page always reflects the real portfolio.
const allWork = await getCollection('work')

// FAQs come from the shared collection, filtered to the ones flagged for this
// page — so the copy lives in exactly one place.
const faqs = (await getCollection('faqs'))
  .filter((f) => f.data.showOn.includes('home'))
  .sort((a, b) => a.data.order - b.data.order)
const featuredWork = allWork
  .filter((w) => w.data.featured)
  .sort((a, b) => b.data.year - a.data.year || (a.data.order ?? 999) - (b.data.order ?? 999))
  .slice(0, 3)
const quotes = allWork
  .filter((w) => w.data.testimonial)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 2)

const steps = [
  {
    title: 'Book a free strategy call',
    note: "Tell us what's working and what isn't. You'll get honest recommendations either way.",
  },
  {
    title: 'Get a clear plan and price',
    note: "A plain-language proposal — what we'll build, what it costs, when it ships.",
  },
  {
    title: 'Launch, then keep improving',
    note: 'We stay on after launch to keep your site fast, secure, and earning its keep.',
  },
]

const guides = [
  {
    tag: 'Pricing',
    title: 'What a website really costs in Albuquerque',
    blurb: 'Honest ranges for small business sites, and what actually drives the number up or down.',
    href: '/albuquerque-web-design-pricing-guide',
  },
  {
    tag: 'Real estate',
    title: 'What Realtors need from a website',
    blurb: 'IDX, lead capture, and the things that actually convert a browser into a client.',
    href: '/blog/real-estate-web-designers',
  },
  {
    tag: 'Local SEO',
    title: 'Choosing an SEO company in Albuquerque',
    blurb: 'What to ask, what to avoid, and how to tell real local expertise from a sales pitch.',
    href: '/blog/albuquerque-seo-company',
  },
]
---

<Base
  title="Albuquerque Web Design, Custom Software & AI | MIS, Inc. — Since 1995"
  description={site.description}
>
  <!-- Hero -->
  <div class="mx-auto max-w-(--container-content) px-6 md:px-10">
    <section class="grid items-center gap-9 py-14 lg:grid-cols-[1.08fr_0.92fr] lg:py-[76px]">
      <div>
        <span
          class="text-xs font-bold uppercase tracking-(--tracking-label) text-primary"
        >
          Web design &middot; Custom software &middot; Practical AI
        </span>

        <h1 class="my-5 text-4xl font-bold text-ink">
          The web keeps changing.<br />
          <span id="type-a">We&rsquo;ve been building it </span><span
            id="type-b"
            class="text-primary">since&nbsp;1995.</span
          ><span class="caret" id="caret" aria-hidden="true"></span>
        </h1>

        <p class="mb-7 max-w-(--container-prose) text-lg text-ink-soft">MIS, Inc. is a boutique web design and development studio based in Albuquerque, New Mexico. We build websites, custom software, and practical AI for small businesses and nonprofits &mdash; here at home and around the world.</p>

        <div class="flex flex-wrap items-center gap-3.5">
          <Button href="/free-consultation">Book a free strategy call</Button>
          <Button href="/portfolio" variant="ghost">See our work</Button>
        </div>

        <p class="mt-4 text-sm font-semibold text-ink-muted">
          A real conversation with the people who&rsquo;ll actually do the work.
        </p>
      </div>

      <figure class="m-0 overflow-hidden rounded-md border border-line-soft shadow-media">
        <div class="relative aspect-[16/10] lg:aspect-[4/5]">
          <!-- TODO(video): when compressing this to ~1.5 MB with ffmpeg, export a
               first-frame poster at the same time and add poster="/img/anniversary-balloon-poster.jpg".
               Currently 4.8 MB, which is the heaviest asset on the page. -->
          <video
            class="absolute inset-0 h-full w-full object-cover"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="The MIS, Inc. hot air balloon rising over the Albuquerque International Balloon Fiesta"
          >
            <source src="/video/anniversary-balloon.mp4" type="video/mp4" />
          </video>
          <figcaption
            class="absolute inset-x-0 bottom-0 bg-linear-to-t from-ink/75 to-transparent px-4 pb-3.5 pt-6 text-xs font-bold uppercase tracking-(--tracking-label) text-[#fff6e6]"
          >
            Our 30th anniversary balloon over Albuquerque
          </figcaption>
        </div>
      </figure>
    </section>
  </div>

  <!-- Facts -->
  <div class="border-y border-line bg-paper-tint">
    <div class="grid grid-cols-2 lg:grid-cols-4">
      {
        facts.map((f) => (
          <div class="px-5 py-6 text-center" data-reveal>
            <b
              class="block font-display text-[32px] font-bold tabular-nums text-primary"
              data-count={f.count}
              data-suffix={f.suffix}
            >
              {f.value}
            </b>
            <span class="text-xs font-bold uppercase tracking-(--tracking-label) text-ink-muted">
              {f.label}
            </span>
          </div>
        ))
      }
    </div>
  </div>

  <Marquee />

  <!-- Services -->
  <Section id="services">
    <SectionHeader eyebrow="Services" title="Three ways we can help" lede="Everything under one roof, from your first website to your first AI agent so you are never coordinating three vendors who do not talk to each other." class="mb-10" />

    <div class="grid gap-5 lg:grid-cols-3">
      {
        featured.map((s) => (
          <Card
            variant="service"
            tag={s.data.title}
            title={s.data.heading}
            blurb={s.data.summary}
            bullets={s.data.highlights}
            href={`/services/${s.id}`}
            cta={`Explore ${s.data.title.toLowerCase()}`}
          />
        ))
      }
    </div>

    <div class="mt-10">
      <Button href="/services" variant="ghost">See all services</Button>
    </div>
  </Section>

  <!-- Eras -->
  <Section id="about">
    <SectionHeader eyebrow="Since 1995" title="We’ve built through every era of the web" lede="Most agencies are younger than some of our client relationships. Every few years the web reinvents itself and our job has always been to figure out what actually matters and put it to work for you." class="mb-10" />

    <Timeline />
  </Section>

  <!-- Process -->
  <Section>
    <div class="grid gap-9 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14">
      <div data-reveal>
        <SectionHeader
          eyebrow="Albuquerque, New Mexico"
          title="Rooted here, working anywhere"
          class="mb-0"
        />
        <div class="mt-4 max-w-(--container-prose) text-ink-soft">
          <p class="mb-4">We&rsquo;ve spent {yearsInBusiness} years working with clients around the world, and what we want most now is to put that experience to work close to home for the small businesses and nonprofits that make New Mexico what it is.</p>
          <p>That means straight answers, fair pricing, and a partner you can actually meet for coffee. No account managers, no handoffs, you work directly with the people building your project.</p>
        </div>
      </div>

      <div class="flex flex-col">
        {
          steps.map((s, i) => (
            <div
              class="flex items-start gap-4 py-5 not-first:border-t not-first:border-line-soft"
              data-reveal
            >
              <span class="grid h-[38px] w-[38px] shrink-0 place-items-center rounded-full bg-paper-surface font-display text-base font-bold text-primary">
                {i + 1}
              </span>
              <div>
                <b class="mb-1 block text-[16.5px] font-extrabold text-ink">{s.title}</b>
                <p class="text-sm text-ink-soft">{s.note}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- Work -->
  <Section id="work">
    <SectionHeader
      eyebrow="Selected work"
      title="Recent projects"
      lede="A few things we have built lately. Every project gets the same treatment: understand the goal, build the simplest thing that achieves it, stick around to keep it working."
      class="mb-10"
    />

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        featuredWork.map((w) => (
          <WorkCard
            slug={w.id}
            title={w.data.title}
            client={w.data.client}
            summary={w.data.summary}
            category={w.data.category}
            image={w.data.image}
            imageAlt={w.data.imageAlt}
            year={w.data.year}
            hasTestimonial={Boolean(w.data.testimonial)}
          />
        ))
      }
    </div>

    <div class="mt-10">
      <Button href="/portfolio" variant="ghost">See all our work</Button>
    </div>
  </Section>

  <!-- Testimonials -->
  {
    quotes.length > 0 && (
      <Section variant="tint" width="full">
        <div class="mx-auto max-w-(--container-content) px-6 py-14 md:px-10 lg:py-20">
          <SectionHeader eyebrow="In their words" title="What clients say" lede="A few testimonials from our clients" class="mb-10" />
          <div class="grid gap-6 lg:grid-cols-2">
            {quotes.map((w) => (
              <Testimonial
                quote={w.data.testimonial!.quote}
                attribution={w.data.testimonial!.attribution}
                href={`/works/${w.id}`}
              />
            ))}
          </div>
        </div>
      </Section>
    )
  }


  <!-- FAQ -->
  <Section id="faq">
    <SectionHeader eyebrow="Common questions" title="Straight answers, before you call" lede="The questions we are asked most often answered plainly, so you can decide whether we are a fit before you spend a minute on the phone." class="mb-10" />
    <FaqList items={faqs} openFirst />
    <p class="mt-8">
      <a href="/faq" class="text-[15px] font-extrabold text-primary no-underline hover:underline">
        See all frequently asked questions &rarr;
      </a>
    </p>
  </Section>

  <!-- Guides -->
  <Section>
    <SectionHeader eyebrow="Notes" title={`Guides from ${yearsInBusiness} years of practice`} lede="Practical writing for New Mexico business owners what things cost, what is worth doing, and what to ignore." class="mb-10" />

    <div class="grid gap-5 lg:grid-cols-3">
      {
        guides.map((g) => (
          <Card variant="note" href={g.href} tag={g.tag} title={g.title} blurb={g.blurb} />
        ))
      }
    </div>

    <div class="mt-10">
      <Button href="/guides" variant="ghost">Read all our guides</Button>
    </div>
  </Section>

  <!-- CTA -->
  <Section divider={false}>
    <CtaBand />
  </Section>

  <script>
    // Hero typewriter. Skipped entirely under reduced motion — the headline is
    // already in the DOM, so it simply renders complete.
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const a = document.getElementById('type-a')
    const b = document.getElementById('type-b')
    const caret = document.getElementById('caret')
    const h1 = a?.closest('h1')

    if (!reduced && a && b && caret && h1) {
      const textA = a.textContent ?? ''
      const textB = b.textContent ?? ''
      a.textContent = ''
      b.textContent = ''
      h1.classList.add('typing')

      let i = 0
      const total = textA.length + textB.length
      const tick = () => {
        i++
        if (i <= textA.length) {
          a.textContent = textA.slice(0, i)
          a.parentNode?.insertBefore(caret, b)
        } else {
          a.textContent = textA
          b.textContent = textB.slice(0, i - textA.length)
          b.parentNode?.appendChild(caret)
        }
        if (i < total) setTimeout(tick, 36)
        else setTimeout(() => h1.classList.remove('typing'), 1800)
      }
      tick()
    }
  </script>
</Base>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PageHero from '../components/PageHero.astro';
import PostCard from '../components/PostCard.astro';
import Card from '../components/Card.astro';
import CtaBand from '../components/CtaBand.astro';
import { yearsInBusiness } from '../lib/site';
import { breadcrumbs, collectionPage } from '../lib/schema';

/**
 * Guides is an INDEX, not a URL space. Posts stay at /blog/<slug> because those
 * URLs carry the search rankings. See docs/blog-migration.md. This page
 * curates the substantial ones and links to them where they already live.
 */
const guides = (await getCollection('blog'))
  .filter((p) => p.data.guide)
  .sort(
    (a, b) =>
      (b.data.updated ?? b.data.date).valueOf() -
      (a.data.updated ?? a.data.date).valueOf(),
  )

const standalone = [
  {
    tag: 'Pricing',
    title: 'What a website costs in Albuquerque',
    blurb: 'Honest ranges for small business sites, and what actually drives the number up or down.',
    href: '/albuquerque-web-design-pricing-guide',
  },
]
const schema = [
  collectionPage({
    name: 'Guides',
    description:
      'In-depth guides on web design pricing, SEO, ecommerce, real estate websites, and AI-assisted search.',
    path: '/guides',
    items: [
      ...guides.map((p) => ({ name: p.data.title, href: `/blog/${p.id}` })),
      ...standalone.map((s) => ({ name: s.title, href: s.href })),
    ],
  }),
  breadcrumbs([{ name: 'Guides' }]),
]
---

<Base
  title="Guides | Web Design, SEO & AI for New Mexico Businesses | MIS, Inc."
  description="In-depth guides on web design pricing, local SEO, ecommerce, real estate websites, and AI-assisted search, written by MIS, Inc."
  schema={schema}
>
  <div class="border-b border-line">
    <PageHero eyebrow="Guides" title="Practical guides" lede={`Most of these began with a client question that needed more than a short answer. They draw on ${yearsInBusiness} years of making these decisions with businesses and nonprofits.`} ctas={[
        { label: 'Book a free consultation', href: '/free-consultation' },
        { label: 'All blog posts', href: '/blog', variant: 'ghost' },
      ]} showMedia={false} layout="centered" />
  </div>

  <Section>
    <SectionHeader
      eyebrow="Guides"
      title="Worth your time"
      class="mb-10"
    />
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        standalone.map((s) => (
          <Card variant="note" href={s.href} tag={s.tag} title={s.title} blurb={s.blurb} cta="Read the guide" />
        ))
      }
      {
        guides.map((p) => (
          <PostCard
            slug={p.id}
            title={p.data.title}
            summary={p.data.summary}
            date={p.data.updated ?? p.data.date}
            updated={Boolean(p.data.updated)}
            guide
          />
        ))
      }
    </div>
  </Section>

  <Section divider={false}>
    <CtaBand
      title="Question we have not written up yet?"
      note="Ask it. If the answer is useful, it usually ends up here."
      ctaLabel="Ask us a question"
      ctaHref="/contact"
    />
  </Section>
</Base>

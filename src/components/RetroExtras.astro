---
/**
 * The two easter-egg widgets for "1995 mode". See the toggle in Header.astro
 * and the theme override in global.css. Both variants render on every page
 * but stay display:none until <html> carries the `retro` class, so there is
 * no per-page wiring and no layout shift when the mode flips.
 */
interface Props {
  variant: 'banner' | 'footer'
}
const { variant } = Astro.props
---

{
  variant === 'banner' && (
    <div class="retro-only border-y-2 border-dashed border-black bg-[#ffcc00] px-4 py-2 text-center">
      <span class="retro-blink text-sm font-bold uppercase text-[#cc0000]">
        🚧 Under construction. Best viewed at 800×600 🚧
      </span>
    </div>
  )
}

{
  variant === 'footer' && (
    <div class="retro-only flex flex-wrap items-center justify-center gap-4 border-t-2 border-dashed border-black bg-[#ffffcc] px-4 py-4">
      <div class="flex items-center gap-2 border-2 border-black bg-black px-3 py-1.5 font-mono">
        <span class="text-[10px] font-bold uppercase text-[#00ff00]">You are visitor #</span>
        <span id="retro-hit-counter" class="text-base tabular-nums text-[#00ff00]">
          000000
        </span>
      </div>
      <div class="border-2 border-black bg-[#0000cc] px-3 py-1.5 text-center text-[10px] font-bold uppercase leading-tight text-white">
        ✔ Best viewed in
        <br />
        Netscape Navigator
      </div>
    </div>
  )
}

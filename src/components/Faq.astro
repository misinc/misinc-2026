---
/**
 * FAQ accordion built on native <details>, so it works without JavaScript and
 * stays crawlable. Emits FAQPage JSON-LD unless `schema` is turned off — pass
 * false when another FAQ block on the same page already emits it.
 */
export interface FaqItem {
  q: string
  a: string
}

interface Props {
  items: FaqItem[]
  /** Opens the first item. Helpful when the FAQ is the page's main content. */
  openFirst?: boolean
  schema?: boolean
  class?: string
}

const { items, openFirst = true, schema = true, class: className = '' } = Astro.props

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}
---

<div class:list={['max-w-[800px]', className]}>
  {
    items.map((f, i) => (
      <details class="group border-b border-line-soft py-1" open={openFirst && i === 0} data-reveal>
        <summary class="relative cursor-pointer list-none py-4 pr-10 font-display text-[19px] font-semibold text-ink hover:text-primary">
          {f.q}
          <span class="pointer-events-none absolute right-2 top-1/2 -mt-[7px] h-[11px] w-[11px] rotate-45 border-b-[2.5px] border-r-[2.5px] border-primary transition-transform group-open:-mt-[3px] group-open:rotate-[-135deg]" />
        </summary>
        <p class="m-0 max-w-[68ch] pb-5 text-[15.5px] text-ink-soft">{f.a}</p>
      </details>
    ))
  }
</div>

{schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

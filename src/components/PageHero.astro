---
import Button from './Button.astro'

/**
 * The hero every page opens with: eyebrow, heading, description, optional
 * buttons, and a piece of media beside it.
 *
 * Media is OPTIONAL by design. Real photography and video are still being
 * produced, so a page with no asset yet falls back to a branded panel that
 * looks deliberate rather than broken. Adding the real thing later is a
 * one-line change — set `media` and nothing else moves.
 *
 *   media={{ type: 'video', src: '/video/x.mp4', caption: '…' }} shape="portrait"
 *   media={{ type: 'video', src: '/video/x.mp4', caption: '…' }}   ← landscape
 *   media={{ type: 'image', src: '/img/work/x.jpg', alt: '…' }}
 *   (omit)  → branded fallback panel
 *
 * Large decorative videos can set `desktopOnly: true`. Their source is added
 * only on screens at least 768px wide and only when reduced motion is off, so
 * phones and visitors who prefer less motion keep the poster without fetching
 * the video.
 *
 * `layout` chooses the composition — `split` (default), `centered`, `full`,
 * or `background`. See the prop for when each applies.
 *
 * `shape` controls the frame, not the file: both shapes accept either media
 * type, and the asset is cropped with object-fit. A 16:9 video shown in a
 * `portrait` frame reads as a vertical clip on desktop — which is what the
 * home page wants — while `landscape` keeps site screenshots and wide video
 * uncropped.
 */

export interface HeroMedia {
  type: 'video' | 'image'
  src: string
  /** Required for images; videos use `caption` for their visible label. */
  alt?: string
  caption?: string
  poster?: string
  /** Keep the poster on small screens and when reduced motion is requested. */
  desktopOnly?: boolean
  /**
   * object-position for the crop, e.g. 'center', 'left top', '50% 20%'.
   * Defaults to the top-left for images (screenshots read from there) and
   * the center for video.
   */
  position?: string
}

export interface HeroMediaChoice {
  src: string
  alt: string
  caption?: string
  position?: string
}

interface Props {
  eyebrow?: string
  title: string
  lede?: string
  ctas?: { label: string; href: string; variant?: 'primary' | 'ghost' }[]
  note?: string
  media?: HeroMedia
  /** Image choices selected in the browser on each page load. */
  mediaChoices?: HeroMediaChoice[]
  /** Optional text beneath the MIS logo when no media is supplied. */
  fallbackLabel?: string
  /** `portrait` suits tall video; `landscape` suits site screenshots. */
  shape?: 'portrait' | 'landscape'
  /**
   * `split` is the default: text left, media beside it.
   *
   * `centered` stacks instead: text centered at a 900px measure with the media
   * full width beneath. Worth reaching for when a headline is too long for the
   * split layout's ~520px column, since that column forces a long headline to
   * break mid-phrase. It also lets a 16:9 source show uncropped.
   *
   * `full` is shorthand for `split` with `showMedia={false}`, kept because
   * several pages already use it.
   *
   * `background` full-bleeds the media behind the text instead of framing it
   * beside or beneath — a dark scrim (see `overlayColor`/`overlayOpacity`)
   * keeps the text legible. There is no separate figure, so `shape` is
   * ignored; the media always fills the hero. Reaches for this when the
   * media is meant to set a mood rather than illustrate a point.
   *
   * `background` layout only also exposes an `edge` slot, rendered full-width
   * beneath the text column rather than inside its padded/max-width column —
   * for content meant to bleed to the section's edges, like a marquee.
   */
  layout?: 'split' | 'centered' | 'full' | 'background'
  /**
   * `background` layout only. The scrim color over the media, as a hex
   * string. Defaults to the ink token so it stays on-brand rather than a
   * generic black.
   */
  overlayColor?: string
  /**
   * `background` layout only. Scrim strength at its darkest point, 0–100.
   * Higher protects text legibility on busy/bright media; lower shows more
   * of the media through. Defaults to 70.
   */
  overlayOpacity?: number
  /**
   * Set false for a page with no image or video. No figure is rendered, not
   * even the branded fallback panel, so the hero does not leave a hole where
   * an image was never going to be, and `split` collapses to a single
   * full-width column.
   *
   * This is deliberately independent of `layout`: a centered hero with no media
   * is a different thing from a full-width one, and both are wanted. The lede
   * keeps its 62ch measure either way, because a readable line length matters
   * more than filling the width.
   */
  showMedia?: boolean
  /**
   * Typewriter effect on a second headline line — home page only. The text
   * types out after `title`, with `highlight` in the accent color.
   */
  typed?: { text: string; highlight?: string }
  /** Use a solid ink panel when text sits over especially variable media. */
  contrastPanel?: boolean
}

const {
  eyebrow,
  title,
  lede,
  ctas = [],
  note,
  media,
  mediaChoices = [],
  fallbackLabel,
  shape = 'landscape',
  layout = 'split',
  showMedia = true,
  typed,
  contrastPanel = false,
  overlayColor = '#4a3115', // --color-ink
  overlayOpacity = 70,
} = Astro.props

const centered = layout === 'centered'
const isBackground = layout === 'background'
const withMedia = showMedia && layout !== 'full'
const deferredVideo = media?.type === 'video' && media.desktopOnly

// Centered puts the media at the full content width, so a portrait frame would
// become a tower — it is capped and centered instead. Landscape gets 16:9,
// which is what the source video actually is. Background ignores this
// entirely — the media fills the hero, there's no separate frame.
const aspect = centered
  ? shape === 'portrait'
    ? 'aspect-[16/10] sm:aspect-[4/5]'
    : 'aspect-[16/10] lg:aspect-[16/9]'
  : shape === 'portrait'
    ? 'aspect-[16/10] lg:aspect-[4/5]'
    : 'aspect-[16/10]'
const position =
  media?.position ?? (isBackground ? 'center' : media?.type === 'image' ? 'left top' : 'center')

// Overlay is built as an inline style, not Tailwind classes, because
// overlayColor/overlayOpacity are arbitrary runtime values Tailwind's build-time
// scanner can't see. Two stacked gradients — bottom-up and left-to-right — keep
// left-aligned text legible without flattening the whole image to one flat tint.
const hexToRgb = (hex: string) => {
  const clean = hex.replace('#', '')
  const full = clean.length === 3 ? clean.replace(/(.)/g, '$1$1') : clean
  const n = parseInt(full, 16)
  return `${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}`
}
const overlayRgb = hexToRgb(overlayColor)
const o = overlayOpacity / 100
// Background heroes always keep a sufficiently dark base beneath their text.
// The gradients still shape the image, while the base prevents bright poster
// details from lowering contrast at any viewport or animation frame.
const overlayBase = Math.max(0.72, o * 0.8)
const overlayStyle = isBackground
  ? `background-color: rgba(${overlayRgb}, ${overlayBase}); background-image: linear-gradient(to top, rgba(${overlayRgb}, ${o}) 10%, rgba(${overlayRgb}, ${o * 0.65}) 45%, rgba(${overlayRgb}, 0) 100%), linear-gradient(to right, rgba(${overlayRgb}, ${o * 0.9}) 0%, rgba(${overlayRgb}, ${o * 0.2}) 40%, rgba(${overlayRgb}, 0) 100%)`
  : undefined
---

{
  isBackground ? (
    /* Media fills the hero as a background layer instead of sitting in a
       framed figure. Kept as its own branch (rather than threading
       conditionals through the split/centered markup below) because the
       structure — full-bleed section, absolute media + scrim, text pinned to
       the bottom — is genuinely different, not just a style variant. Keep the
       eyebrow/title/lede/ctas/note/slots in sync with the block below if you
      change one. */
    <section class="relative isolate overflow-hidden" data-hero-layout="background">
      <div class="hero-bg-media absolute inset-0 -z-20">
        {
          media?.type === 'video' && deferredVideo && media.poster && (
            <img
              class="absolute inset-0 h-full w-full object-cover"
              style={`object-position:${position}`}
              src={media.poster}
              alt=""
              loading="eager"
              decoding="async"
              {...({ fetchpriority: 'high' } as Record<string, string>)}
            />
          )
        }
        {
          media?.type === 'video' && (
            <video
              class:list={[
                'h-full w-full object-cover',
                deferredVideo && 'absolute inset-0',
              ]}
              style={`object-position:${position}`}
              muted
              loop
              playsinline
              autoplay={!deferredVideo}
              preload={deferredVideo ? 'none' : 'auto'}
              {...({ fetchpriority: 'high' } as Record<string, string>)}
              poster={deferredVideo ? undefined : media.poster}
              aria-label={media.caption || media.alt}
              data-desktop-video={deferredVideo ? 'true' : undefined}
            >
              <source
                src={deferredVideo ? undefined : media.src}
                data-deferred-src={deferredVideo ? media.src : undefined}
                type="video/mp4"
              />
            </video>
          )
        }
        {
          media?.type === 'image' && (
            <img
              class="h-full w-full object-cover"
              style={`object-position:${position}`}
              src={media.src}
              alt={media.alt ?? ''}
              loading="eager"
            />
          )
        }
        {
          !media && (
            /* Branded fallback until real media exists for this page. */
            <div class="h-full w-full bg-ink" />
          )
        }
      </div>

      {overlayStyle && <div class="hero-bg-overlay absolute inset-0 -z-10" style={overlayStyle} />}

      <div class="relative mx-auto max-w-(--container-content) px-6 md:px-10">
        <div class="flex min-h-[520px] flex-col justify-end py-14 md:min-h-[600px] md:py-20">
          <div
            class:list={[
              'hero-bg-content max-w-[760px]',
              contrastPanel &&
                'rounded-md border border-white/10 bg-ink px-5 py-6 shadow-panel md:px-7 md:py-7',
            ]}
          >
            <slot name="before" />
            {
              eyebrow && (
                <span class="hero-bg-eyebrow text-xs font-bold uppercase tracking-(--tracking-label) text-[#fff6e6]">
                  {eyebrow}
                </span>
              )
            }

            <h1 class="hero-bg-title my-5 text-4xl font-bold text-white" data-hero-title>
              {title}
              {
                typed && (
                  <>
                    <br />
                    {/* prettier-ignore */}
                    <span data-typed-text>{typed.text}</span>{typed.highlight && <span data-typed-highlight class="text-[#fff6e6]">{typed.highlight}</span>}
                    <span class="caret" data-typed-caret aria-hidden="true" />
                  </>
                )
              }
            </h1>

            {
              (lede || Astro.slots.has('lede')) && (
                <p class="hero-bg-lede mb-7 max-w-(--container-prose) text-lg text-white">
                  {Astro.slots.has('lede') ? <slot name="lede" /> : lede}
                </p>
              )
            }

            {
              ctas.length > 0 && (
                <div class="flex flex-wrap items-center gap-3.5">
                  {ctas.map((c) => (
                    <Button href={c.href} variant={c.variant === 'ghost' ? 'ghostOnDark' : 'primary'}>
                      {c.label}
                    </Button>
                  ))}
                </div>
              )
            }

            {note && <p class="hero-bg-note mt-4 text-sm font-semibold text-white">{note}</p>}
            {
              media?.caption && (
                <p class="hero-bg-caption mt-4 text-xs font-bold uppercase tracking-(--tracking-label) text-white">
                  {media.caption}
                </p>
              )
            }

            <slot name="after" />
          </div>
        </div>
      </div>

      {
        Astro.slots.has('edge') && (
          <div class="relative pb-8 md:pb-10">
            <slot name="edge" />
          </div>
        )
      }
    </section>
  ) : (
    <div class="mx-auto max-w-(--container-content) px-6 md:px-10">
      <section
        data-hero-layout={layout}
        class:list={[
          'py-14 lg:py-[76px]',
          !centered && withMedia && 'grid items-center gap-9 lg:grid-cols-[1.08fr_0.92fr]',
        ]}
      >
        <div class:list={[centered && 'mx-auto max-w-[900px] text-center']}>
          <slot name="before" />
          {
            eyebrow && (
              <span class="text-xs font-bold uppercase tracking-(--tracking-label) text-primary">
                {eyebrow}
              </span>
            )
          }

          <h1 class="my-5 text-4xl font-bold text-ink" data-hero-title>
            {title}
            {
              typed && (
                <>
                  <br />
                  {/* prettier-ignore */}
                  <span data-typed-text>{typed.text}</span>{typed.highlight && <span data-typed-highlight class="text-primary">{typed.highlight}</span>}
                  <span class="caret" data-typed-caret aria-hidden="true" />
                </>
              )
            }
          </h1>

          {
            (lede || Astro.slots.has('lede')) && (
              <p
                class:list={[
                  'mb-7 max-w-(--container-prose) text-lg text-ink-soft',
                  centered && 'mx-auto',
                ]}
              >
                {/* The `lede` slot is for copy that needs a link or emphasis, which
                    a string prop cannot carry. It replaces `lede` when both exist. */}
                {Astro.slots.has('lede') ? <slot name="lede" /> : lede}
              </p>
            )
          }

          {
            ctas.length > 0 && (
              <div
                class:list={['flex flex-wrap items-center gap-3.5', centered && 'justify-center']}
              >
                {ctas.map((c) => (
                  <Button href={c.href} variant={c.variant ?? 'primary'}>
                    {c.label}
                  </Button>
                ))}
              </div>
            )
          }

          {note && <p class="mt-4 text-sm font-semibold text-ink-muted">{note}</p>}

          <slot name="after" />
        </div>

        {
          withMedia && (
          <figure
            class:list={[
              'hero-figure m-0 overflow-hidden rounded-md border border-line-soft shadow-media',
              centered && 'mt-11',
              centered && shape === 'portrait' && 'mx-auto max-w-[560px]',
            ]}
            data-random-media={mediaChoices.length > 0 ? JSON.stringify(mediaChoices) : undefined}
          >
            <div class:list={['relative', aspect]}>
              {
                media?.type === 'video' && (
                  <video
                    class="absolute inset-0 h-full w-full object-cover"
                    style={`object-position:${position}`}
                    muted
                    loop
                    playsinline
                    autoplay={!deferredVideo}
                    preload={deferredVideo ? 'none' : 'auto'}
                    poster={media.poster}
                    aria-label={media.caption || media.alt}
                    data-desktop-video={deferredVideo ? 'true' : undefined}
                  >
                    <source
                      src={deferredVideo ? undefined : media.src}
                      data-deferred-src={deferredVideo ? media.src : undefined}
                      type="video/mp4"
                    />
                  </video>
                )
              }

              {
                media?.type === 'image' && (
                  <img
                    class="absolute inset-0 h-full w-full object-cover"
                    style={`object-position:${position}`}
                    src={media.src}
                    alt={media.alt ?? ''}
                    loading="eager"
                    data-random-media-image={mediaChoices.length > 0 ? 'true' : undefined}
                  />
                )
              }

              {
                !media && (
                  /* Branded fallback until real media exists for this page. */
                  <div class="absolute inset-0 grid place-items-center bg-linear-to-br from-paper-surface via-paper-tint to-[#f6dfb4]">
                    {
                      fallbackLabel ? (
                        <div class="flex w-full flex-col items-center gap-5 px-6 text-center">
                          <img
                            src="/img/mis-logo.png"
                            alt=""
                            width="140"
                            height="146"
                            class="w-[28%] max-w-[180px] opacity-40"
                          />
                          <span class="font-display text-2xl font-bold text-primary md:text-3xl">
                            {fallbackLabel}
                          </span>
                        </div>
                      ) : (
                        <img
                          src="/img/mis-logo.png"
                          alt=""
                          width="140"
                          height="146"
                          class="w-[38%] max-w-[180px] opacity-15"
                        />
                      )
                    }
                  </div>
                )
              }

              {
                (media?.caption || mediaChoices.length > 0) && (
                  <figcaption
                    class="absolute inset-x-0 bottom-0 bg-linear-to-t from-ink/75 to-transparent px-4 pb-3.5 pt-6 text-xs font-bold uppercase tracking-(--tracking-label) text-[#fff6e6]"
                    data-random-media-caption={mediaChoices.length > 0 ? 'true' : undefined}
                  >
                    {media?.caption}
                  </figcaption>
                )
              }
            </div>
          </figure>
          )
        }
      </section>
    </div>
  )
}

<script>
  // Service pages can supply a portfolio-image pool. Select in the browser so
  // the image changes on each page load instead of only when Astro builds.
  document.querySelectorAll<HTMLElement>('[data-random-media]').forEach((figure) => {
    if (figure.dataset.randomMediaApplied === 'true') return

    try {
      const choices = JSON.parse(figure.dataset.randomMedia ?? '[]') as {
        src: string
        alt: string
        caption?: string
        position?: string
      }[]
      if (choices.length === 0) return

      const choice = choices[Math.floor(Math.random() * choices.length)]
      const img = figure.querySelector<HTMLImageElement>('[data-random-media-image]')
      const caption = figure.querySelector<HTMLElement>('[data-random-media-caption]')
      if (!img || !choice) return

      img.src = choice.src
      img.alt = choice.alt
      img.style.objectPosition = choice.position ?? 'left top'
      if (caption) {
        caption.textContent = choice.caption ?? ''
        caption.hidden = !choice.caption
      }
      figure.dataset.randomMediaApplied = 'true'
    } catch {
      // Keep the server-rendered image if the choices cannot be read.
    }
  })

  // Hero typewriter, only on pages that pass `typed`. Skipped entirely under
  // reduced motion — the headline is already in the DOM, so it simply renders
  // complete.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  // Large decorative videos are poster-only on phones and for visitors who
  // prefer reduced motion. Adding the source here prevents an eager browser
  // from downloading a hidden or paused video anyway.
  const desktop = window.matchMedia('(min-width: 768px)')
  const loadDesktopVideos = () => {
    if (reduced || !desktop.matches || document.documentElement.classList.contains('retro')) return
    document.querySelectorAll<HTMLVideoElement>('video[data-desktop-video="true"]').forEach((video) => {
      const source = video.querySelector<HTMLSourceElement>('source[data-deferred-src]')
      if (!source?.dataset.deferredSrc || source.src) return
      source.src = source.dataset.deferredSrc
      video.load()
      void video.play().catch(() => {
        // The poster remains visible if the browser blocks autoplay.
      })
    })
  }

  // The poster is the initial hero media. Fetch the decorative 3 MB video
  // only after the visitor interacts, keeping it out of the critical path and
  // avoiding a large transfer for visitors who leave without engaging.
  let videoRequested = false
  const requestDesktopVideos = () => {
    videoRequested = true
    loadDesktopVideos()
    ;['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach((event) =>
      window.removeEventListener(event, requestDesktopVideos),
    )
  }
  ;['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach((event) =>
    window.addEventListener(event, requestDesktopVideos, { passive: true, once: true }),
  )
  desktop.addEventListener('change', () => {
    if (videoRequested) loadDesktopVideos()
  })

  const a = document.querySelector<HTMLElement>('[data-typed-text]')
  const b = document.querySelector<HTMLElement>('[data-typed-highlight]')
  const caret = document.querySelector<HTMLElement>('[data-typed-caret]')
  const h1 = a?.closest('h1')

  if (!reduced && a && caret && h1) {
    // Trim only the indentation the template introduces — a trailing space
    // inside the copy itself is meaningful and must survive.
    const strip = (t: string) => t.replace(/^\s*\n\s*|\s*\n\s*$/g, '')
    const textA = strip(a.textContent ?? '')
    const textB = strip(b?.textContent ?? '')
    a.textContent = ''
    if (b) b.textContent = ''
    h1.classList.add('typing')

    let i = 0
    const total = textA.length + textB.length
    const tick = () => {
      i++
      if (i <= textA.length || !b) {
        a.textContent = textA.slice(0, i)
        a.parentNode?.insertBefore(caret, a.nextSibling)
      } else {
        a.textContent = textA
        b.textContent = textB.slice(0, i - textA.length)
        b.parentNode?.appendChild(caret)
      }
      if (i < total) setTimeout(tick, 36)
      else setTimeout(() => h1.classList.remove('typing'), 1800)
    }
    tick()
  }
</script>

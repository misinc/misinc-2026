---
/**
 * The only button/CTA in the system. Everything that looks like a button
 * should come from here so hover, focus, and shadow stay identical sitewide.
 *
 * Labels on the accent orange are `text-ink`, not white. White on #ff9902 is
 * 2.14:1 — below the 4.5:1 WCAG AA needs for normal text, and below even the
 * 3:1 large-text floor. Ink on the same orange is 5.63:1, so the brand colour
 * is untouched and the label is readable.
 */
interface Props {
  href: string
  variant?: 'primary' | 'ghost' | 'onDark' | 'ghostOnDark'
  size?: 'md' | 'lg'
  class?: string
  [key: string]: unknown
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  ...rest
} = Astro.props

const base =
  'inline-block rounded-full font-extrabold no-underline transition'

const sizes = {
  md: 'px-5 py-3 text-[15px]',
  lg: 'px-6 py-3.5 text-base',
}

const variants = {
  primary:
    'bg-accent text-ink shadow-button hover:-translate-y-px hover:bg-accent-dark',
  ghost:
    'border-[1.5px] border-primary/35 text-primary hover:bg-primary/5',
  onDark:
    'bg-accent text-ink shadow-button hover:-translate-y-px hover:bg-accent-dark',
  /** The `ghost` treatment for a hero (or any section) where the button sits
   * over dark/photographic media instead of the paper background. */
  ghostOnDark:
    'border-[1.5px] border-white/40 text-white hover:bg-white/10',
}
---

<a href={href} class:list={[base, sizes[size], variants[variant], className]} {...rest}>
  <slot />
</a>

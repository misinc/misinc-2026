---
/**
 * The only button/CTA in the system. Everything that looks like a button
 * should come from here so hover, focus, and shadow stay identical sitewide.
 */
interface Props {
  href: string
  variant?: 'primary' | 'ghost' | 'onDark'
  size?: 'md' | 'lg'
  class?: string
  [key: string]: unknown
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  ...rest
} = Astro.props

const base =
  'inline-block rounded-full font-extrabold no-underline transition'

const sizes = {
  md: 'px-5 py-3 text-[15px]',
  lg: 'px-6 py-3.5 text-base',
}

const variants = {
  primary:
    'bg-accent text-white shadow-button hover:-translate-y-px hover:bg-accent-dark',
  ghost:
    'border-[1.5px] border-primary/35 text-primary hover:bg-primary/5',
  onDark:
    'bg-accent text-white shadow-button hover:-translate-y-px hover:bg-accent-dark',
}
---

<a href={href} class:list={[base, sizes[size], variants[variant], className]} {...rest}>
  <slot />
</a>

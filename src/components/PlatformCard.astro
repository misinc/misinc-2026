---
/**
 * Platform card. Shows only the logo — no separate heading — so a wall of
 * cards reads as credentials at a glance rather than a wall of headings.
 *
 * Prefers the full wide wordmark when one exists, since there's room here to
 * show the name, not just the mark; falls back to the square `icon` (the
 * home-hero marquee's mark) for platforms that don't have one yet.
 *
 * The name still exists as the card's heading (for screen readers and search)
 * and as the logo's alt/title text, but is visually hidden.
 */
interface Props {
  slug: string
  name: string
  icon: string
  /** Full wide wordmark — preferred over `icon` when present. */
  wordmark?: string
  summary: string
  /** Wide logos must not be squashed into a square box. */
  wide?: boolean
  /** e.g. "Certified Webflow Partner" — the differentiating claim. */
  credential?: string
  cta?: string
  class?: string
}

const {
  slug,
  name,
  icon,
  wordmark,
  summary,
  wide = false,
  credential,
  cta = 'Read our take',
  class: className = '',
} = Astro.props

// A wordmark is inherently landscape, so it gets the same wide treatment as
// an `icon` that's already wordmark-shaped (e.g. our own Add On products).
const logo = wordmark ?? icon
const isWide = wide || Boolean(wordmark)
---

<a
  href={`/platforms/${slug}`}
  class:list={[
    'group flex flex-col gap-3 rounded-lg border border-line-soft bg-paper-panel p-6 no-underline shadow-card transition hover:-translate-y-[3px] hover:shadow-card-hover',
    className,
  ]}
  data-reveal
>
  <div class="flex h-12 items-center">
    <img
      src={logo}
      title={name}
      alt={name}
      loading="lazy"
      class:list={['block', isWide ? 'h-8 w-auto max-w-[80%]' : 'h-10 w-10']}
    />
  </div>

  <h3 class="sr-only">{name}</h3>

  {
    credential && (
      <span class="w-fit rounded-full bg-paper-surface px-2.5 py-1 text-[11px] font-extrabold uppercase tracking-(--tracking-label) text-primary">
        {credential}
      </span>
    )
  }

  <p class="text-sm text-ink-soft">{summary}</p>

  <span class="mt-auto pt-2 text-sm font-extrabold text-primary">
    {cta}
    <span class="inline-block transition-transform group-hover:translate-x-1" aria-hidden="true">
      &rarr;
    </span>
  </span>
</a>

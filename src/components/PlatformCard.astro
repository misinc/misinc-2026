---
/**
 * Platform card. Leads with the logo rather than the name — the marks are more
 * recognisable than the words, and a wall of logos reads as credentials at a
 * glance in a way a wall of headings does not.
 *
 * The name still renders as the card's heading for screen readers and search,
 * visually below the mark.
 */
interface Props {
  slug: string
  name: string
  icon: string
  summary: string
  /** Wide wordmarks must not be squashed into a square box. */
  wide?: boolean
  /** e.g. "Certified Webflow Partner" — the differentiating claim. */
  credential?: string
  cta?: string
  class?: string
}

const {
  slug,
  name,
  icon,
  summary,
  wide = false,
  credential,
  cta = 'Read our take',
  class: className = '',
} = Astro.props
---

<a
  href={`/platforms/${slug}`}
  class:list={[
    'group flex flex-col gap-3 rounded-lg border border-line-soft bg-paper-panel p-6 no-underline shadow-card transition hover:-translate-y-[3px] hover:shadow-card-hover',
    className,
  ]}
  data-reveal
>
  <div class="flex h-12 items-center">
    <img
      src={icon}
      title={name}
      alt={name}
      loading="lazy"
      class:list={['block', wide ? 'h-8 w-auto max-w-[80%]' : 'h-10 w-10']}
    />
  </div>

  <h3 class="font-display text-lg font-bold text-ink">{name}</h3>

  {
    credential && (
      <span class="w-fit rounded-full bg-paper-surface px-2.5 py-1 text-[11px] font-extrabold uppercase tracking-(--tracking-label) text-primary">
        {credential}
      </span>
    )
  }

  <p class="text-sm text-ink-soft">{summary}</p>

  <span class="mt-auto pt-2 text-sm font-extrabold text-primary">
    {cta}
    <span class="inline-block transition-transform group-hover:translate-x-1" aria-hidden="true">
      &rarr;
    </span>
  </span>
</a>

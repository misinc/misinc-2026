{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  // Cloudflare's dashboard for this project (Workers & Pages -> misinc-2026)
  // already runs `npm run build` then `npx wrangler deploy` — this file is
  // what was missing to tell that deploy about anything beyond static files.
  // Without it the project is "a Worker with only static assets": every page
  // Astro builds serves fine, but there is no Worker script, so a path like
  // /api/contact 404s exactly like a missing image would, and the Variables
  // and secrets that functions/api/contact.js needs (RESEND_API_KEY etc.)
  // can't even be set in the dashboard while the project stays assets-only.
  "name": "misinc-2026",
  "compatibility_date": "2026-08-20",
  "main": "worker/entry.js",
  // Plaintext vars for functions/api/contact.js. These are committed here on
  // purpose: `wrangler deploy` (which Cloudflare's dashboard build runs on
  // every push) treats this file as the source of truth for plain vars and
  // wipes anything set by hand in the dashboard that isn't declared here.
  // RESEND_API_KEY is NOT here because it's a secret, not a var — it must
  // stay set via `wrangler secret put RESEND_API_KEY` or the dashboard's
  // "Secret" type, which `wrangler deploy` does not touch.
  "vars": {
    "CONTACT_TO": "hello@misinc.com",
    "CONTACT_FROM": "website@misinc.com"
  },
  "assets": {
    // Astro's static build output. Cloudflare's default returns an empty 404
    // for unmatched assets; `404-page` serves Astro's built 404.html while
    // preserving the correct HTTP 404 status. SPA fallback would incorrectly
    // turn missing content URLs into the home page.
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
